<%- include('layouts/header', { tituloDaPagina: 'Dr.Pet | Administrador' , quill: true }) %>

    <!-- transformar navegação em rotas -->
    <div class="bg-gray-50 min-h-screen">
        <main class="container px-4 md:px-20 py-10 md:py-[120px] flex flex-col items-center">
            <nav class="flex items-center justify-center flex-wrap gap-4 sm:gap-6 lg:gap-10 w-full max-w-[1288px]">
                <button type="button" data-tab-btn data-target="section-slides"
                    class="flex justify-center items-center px-4 py-3 md:py-4 w-[140px] xs:w-[160px] sm:w-[180px] lg:w-[270px] bg-green-600 rounded-[10px] shadow-[3px_3px_8px_0px_rgba(0,0,0,0.1)] hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all shrink-0">
                    <span
                        class="font-sans font-semibold text-lg xs:text-xl lg:text-3xl leading-snug lg:leading-10 text-gray-50">Slides</span>
                </button>

                <button type="button" data-tab-btn data-target="section-agenda"
                    class="flex justify-center items-center px-4 py-3 md:py-4 w-[140px] xs:w-[160px] sm:w-[180px] lg:w-[270px] bg-gray-200 rounded-[10px] hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-green-600/50 transition-all shrink-0">
                    <span
                        class="font-sans font-semibold text-lg xs:text-xl lg:text-3xl leading-snug lg:leading-10 text-green-700">Agenda</span>
                </button>

                <button type="button" data-tab-btn data-target="section-servicos"
                    class="flex justify-center items-center px-4 py-3 md:py-4 w-[140px] xs:w-[160px] sm:w-[180px] lg:w-[270px] bg-gray-200 rounded-[10px] hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-green-600/50 transition-all shrink-0">
                    <span
                        class="font-sans font-semibold text-lg xs:text-xl lg:text-3xl leading-snug lg:leading-10 text-green-700">Serviços</span>
                </button>

                <button type="button" data-tab-btn data-target="section-agendamentos"
                    class="flex justify-center items-center px-4 py-3 md:py-4 w-[140px] xs:w-[160px] sm:w-[180px] lg:w-[270px] bg-gray-200 rounded-[10px] hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-green-600/50 transition-all shrink-0">
                    <span
                        class="font-sans font-semibold text-lg xs:text-xl lg:text-3xl leading-snug lg:leading-10 text-green-700">Solicitações</span>
                </button>

                <button type="button" data-tab-btn data-target="section-produtos"
                    class="flex justify-center items-center px-4 py-3 md:py-4 w-[140px] xs:w-[160px] sm:w-[180px] lg:w-[270px] bg-gray-200 rounded-[10px] hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-green-600/50 transition-all shrink-0">
                    <span
                        class="font-sans font-semibold text-lg xs:text-xl lg:text-3xl leading-snug lg:leading-10 text-green-700">Produtos</span>
                </button>

                <button type="button" data-tab-btn data-target="section-relatorios"
                    class="flex justify-center items-center px-4 py-3 md:py-4 w-[140px] xs:w-[160px] sm:w-[180px] lg:w-[270px] bg-gray-200 rounded-[10px] hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-green-600/50 transition-all shrink-0">
                    <span
                        class="font-sans font-semibold text-lg xs:text-xl lg:text-3xl leading-snug lg:leading-10 text-green-700">Relatórios</span>
                </button>
            </nav>

            <section id="section-slides" data-tab-content
                class="animate-fadeLeft opacity-0 w-full max-w-[1400px] mt-10 md:mt-20">
                <h2
                    class="font-sans font-bold text-xl md:text-3xl leading-tight md:leading-[40px] text-green-700 whitespace-nowrap">
                    Slides
                </h2>
                <picture data-content-slides
                    class="mt-5 md:mt-10 flex items-center gap-10 py-5 w-full overflow-x-auto flex-nowrap md:flex-wrap md:overflow-visible">
                    <% if(slides.length !==0) { %>
                        <% slides.forEach(slide=> { %>
                            <figure style="background-image: url('/administrador/slide-home/imagem/<%= slide.id %>');"
                                aria-label="<%= slide.alt || 'Slide' %>" data-content-slides="<%= slide.id %>"
                                class="animate-fadeLeft relative w-[280px] h-[148px] rounded-[10px] shrink-0 bg-cover bg-center bg-no-repeat">
                                <div class="absolute inset-0 bg-black/25 rounded-[10px]"></div>

                                <button type="button" data-id="<%= slide.id %>"
                                    class="delete-slide-btn absolute -top-[12px] -right-[12px] flex items-center justify-center p-3 bg-gray-200 rounded-full hover:bg-gray-300 transition-colors z-10 shadow-sm cursor-pointer">
                                    <img src="../images/icons/administrador/delete-slide.svg" alt="Remover slide"
                                        class="w-5 h-5 pointer-events-none">
                                </button>
                            </figure>
                            <% }) %>
                                <% } %>

                                    <label type="file" data-add-slide for="button-add-slide-file"
                                        class="cursor-pointer max-w-[280px] min-w-[200px] h-[148px] w-full flex flex-col items-center justify-center gap-5 px-[30px] py-5 border-2 border-dashed border-gray-400 rounded-[10px] hover:bg-gray-200 transition-colors shrink-0">
                                        <img src="/images/icons/administrador/plus-slide.svg" alt="Adicionar"
                                            class="w-10 h-10" />
                                        <span class="font-sans font-semibold text-[20px] leading-[25px] text-green-600">
                                            Adicionar Slide
                                        </span>
                                        <input type="file" class="hidden overflow-hidden" id="button-add-slide-file" />
                                    </label>
                </picture>
            </section>

            <section id="section-agenda" data-tab-content
                class="animate-fadeLeft opacity-0 hidden w-full max-w-[1400px] mt-10 md:mt-20">
                <div class="flex flex-col gap-10 w-full">
                    <h2
                        class="font-sans font-bold text-xl md:text-3xl leading-tight md:leading-[40px] text-green-700 whitespace-nowrap">
                        Agenda
                    </h2>
                    <div class="flex flex-wrap items-end gap-10 w-full">
                        <div class="flex flex-col gap-[15px]">
                            <label class="font-sans font-semibold text-xl md:text-[26px] leading-[32px] text-gray-700">
                                Escolha a data
                            </label>
                            <div class="relative w-[220px]">
                                <input type="date" data-input-date="adm" min="2026-01-01"
                                    class="px-5 py-[10px] w-full border-2 border-green-600 rounded-[5px] shadow-sm font-medium text-lg md:text-[22px] leading-[27px] text-gray-600 outline-none cursor-pointer focus:ring-4 focus:ring-green-600/30 transition-all [&::-webkit-calendar-picker-indicator]:opacity-0 [&::-webkit-calendar-picker-indicator]:cursor-pointer" />
                                <img src="/images/icons/administrador/calendar-plus.svg" alt="Calendário"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 w-6 h-6 pointer-events-none" />
                            </div>
                        </div>

                        <div class="flex flex-col gap-[15px]">
                            <label class="font-sans font-semibold text-xl md:text-[26px] leading-[32px] text-gray-700">
                                Escolha o Serviço
                            </label>
                            <div class="relative w-[280px]">
                                <select data-select="service"
                                    class="px-5 py-[10px] w-full border-2 border-green-600 rounded-[5px] shadow-sm font-medium text-lg md:text-[22px] leading-[27px] text-gray-600 outline-none bg-white cursor-pointer appearance-none focus:ring-4 focus:ring-green-600/30 transition-all">
                                    <% if (locals.servicos && servicos.length> 0) { %>
                                        <option value="all" selected>
                                            Todas as Opções
                                        </option>
                                        <% servicos.forEach(servico=> { %>
                                            <option value="<%= servico.id %>">
                                                <%= servico.nome %>
                                            </option>
                                            <% }) %>
                                                <% } else { %>
                                                    <option value="" disabled selected>Nenhum Serviço</option>
                                                    <% } %>
                                </select>
                                <img src="/images/icons/arrow-down.svg" alt="Seta"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 w-8 h-8 pointer-events-none" />
                            </div>
                        </div>

                    </div>
                </div>

                <div data-content-schedule
                    class="mt-10 grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-[30px] md:gap-[50px] w-full overflow-y-auto max-h-[1000px] scroll pb-2 pr-2">
                    <p class="animate-fadeItem text-lg font-semibold text-gray-700 text-center col-span-full py-8">
                        Não há nenhum agendamento para este dia e serviço selecionados.
                    </p>
                </div>

            </section>

            <section id="section-servicos" data-tab-content
                class="animate-fadeLeft opacity-0 hidden w-full max-w-[1400px] mt-10 md:mt-20">
                <div class="flex flex-col gap-6 w-full">
                    <div class="flex flex-col gap-2">
                        <h2
                            class="font-sans font-bold text-xl md:text-3xl leading-tight md:leading-[40px] text-green-700 whitespace-nowrap">
                            Serviços
                        </h2>
                        <p class="font-sans font-medium text-base md:text-lg text-gray-600">
                            Cadastre, atualize ou remova os serviços oferecidos pela Dr.Pet.
                        </p>
                    </div>

                    <div
                        class="relative grid grid-cols-1 sm:grid-cols-3 gap-x-4 sm:gap-x-6 gap-y-8 p-7 md:p-[40px] bg-white rounded-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] w-full border-t-[6px] border-green-600">

                        <input type="radio" name="servico-modo" id="servico-modo-criar" value="criar"
                            class="peer/criar sr-only" checked />
                        <input type="radio" name="servico-modo" id="servico-modo-atualizar" value="atualizar"
                            class="peer/atualizar sr-only" />
                        <input type="radio" name="servico-modo" id="servico-modo-deletar" value="deletar"
                            class="peer/deletar sr-only" />

                        <label for="servico-modo-criar"
                            class="flex justify-center items-center px-4 py-3 md:py-4 bg-gray-200 rounded-[10px] cursor-pointer font-sans font-semibold text-base xs:text-lg md:text-2xl text-center text-green-700 hover:bg-gray-300 transition-all peer-checked/criar:bg-green-600 peer-checked/criar:text-gray-50 peer-checked/criar:hover:bg-green-700 peer-checked/criar:shadow-[3px_3px_8px_0px_rgba(0,0,0,0.1)] peer-focus-visible/criar:ring-4 peer-focus-visible/criar:ring-green-600/50">
                            Criar Novo Serviço
                        </label>
                        <label for="servico-modo-atualizar"
                            class="flex justify-center items-center px-4 py-3 md:py-4 bg-gray-200 rounded-[10px] cursor-pointer font-sans font-semibold text-base xs:text-lg md:text-2xl text-center text-green-700 hover:bg-gray-300 transition-all peer-checked/atualizar:bg-green-600 peer-checked/atualizar:text-gray-50 peer-checked/atualizar:hover:bg-green-700 peer-checked/atualizar:shadow-[3px_3px_8px_0px_rgba(0,0,0,0.1)] peer-focus-visible/atualizar:ring-4 peer-focus-visible/atualizar:ring-green-600/50">
                            Atualizar Serviço
                        </label>
                        <label for="servico-modo-deletar"
                            class="flex justify-center items-center px-4 py-3 md:py-4 bg-gray-200 rounded-[10px] cursor-pointer font-sans font-semibold text-base xs:text-lg md:text-2xl text-center text-green-700 hover:bg-gray-300 transition-all peer-checked/deletar:bg-green-600 peer-checked/deletar:text-gray-50 peer-checked/deletar:hover:bg-green-700 peer-checked/deletar:shadow-[3px_3px_8px_0px_rgba(0,0,0,0.1)] peer-focus-visible/deletar:ring-4 peer-focus-visible/deletar:ring-green-600/50">
                            Deletar Serviços
                        </label>

                        <div class="hidden sm:col-span-3 flex-col gap-6 peer-checked/criar:flex animate-fadeItem">
                            <form action="/administrador/servicos/criar" method="POST" enctype="multipart/form-data"
                                class="flex flex-col gap-6 w-full">

                                <div class="flex flex-col md:flex-row flex-wrap gap-6 w-full">
                                    <div class="flex flex-col gap-[10px] flex-1 min-w-[250px]">
                                        <label for="novo-servico-nome"
                                            class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                            Nome do Serviço
                                        </label>
                                        <input type="text" maxlength="16" id="novo-servico-nome" name="nome"
                                            placeholder="Ex: Tosa Higiênica" required
                                            class="px-5 py-[10px] w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400" />
                                    </div>

                                    <div class="flex flex-col gap-[10px] flex-1 min-w-[180px]">
                                        <label for="novo-servico-duracao"
                                            class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                            Duração (min)
                                        </label>
                                        <input type="text" maxlength="8" id="novo-servico-duracao" name="duracao"
                                            placeholder="Ex: 60 min" required
                                            class="px-5 py-[10px] w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400" />
                                    </div>

                                    <div class="flex flex-col gap-[10px] flex-1 min-w-[180px]">
                                        <label for="novo-servico-preco"
                                            class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                            Preço (R$)
                                        </label>
                                        <input type="text" maxlength="11" id="novo-servico-preco" name="preco"
                                            placeholder="R$ 0,00" required
                                            class="px-5 py-[10px] w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400" />
                                    </div>
                                </div>

                                <div class="flex flex-col gap-[10px]">
                                    <label for="novo-servico-descricao"
                                        class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                        Descrição
                                    </label>
                                    <textarea id="novo-servico-descricao" name="descricao" maxlength="500" rows="4"
                                        required placeholder="Descreva o que está incluso neste serviço..."
                                        class="px-5 py-3 w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none resize-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400"></textarea>
                                </div>

                                <div class="flex flex-col gap-[10px]">
                                    <span class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                        Imagem do Serviço
                                    </span>
                                    <input type="file" id="novo-servico-imagem" name="imagem" accept="image/*" required
                                        class="peer sr-only" />
                                    <label for="novo-servico-imagem"
                                        class="cursor-pointer relative flex flex-col items-center justify-center min-h-[140px] px-4 py-6 border-2 border-dashed border-gray-400 rounded-[10px] hover:border-green-500 hover:bg-green-50/50 peer-focus-visible:border-green-500 peer-focus-visible:ring-4 peer-focus-visible:ring-green-600/30 transition-all overflow-hidden group">
                                        
                                        <!-- Estado Inicial: Sem imagem selecionada -->
                                        <div data-placeholder="novo-servico" class="flex flex-col items-center justify-center gap-3">
                                            <img src="/images/icons/administrador/plus-slide.svg" alt="Adicionar imagem"
                                                class="w-8 h-8 opacity-60 group-hover:opacity-100 transition-opacity" />
                                            <span class="font-sans font-medium text-sm md:text-base text-gray-500 text-center">
                                                Clique para selecionar a imagem do serviço
                                            </span>
                                        </div>

                                        <!-- Estado com Preview: Imagem selecionada -->
                                        <div data-preview-wrapper="novo-servico" class="hidden flex-col items-center justify-center gap-2 w-full animate-fadeItem">
                                            <div class="relative rounded-[8px] overflow-hidden shadow-sm border border-gray-200 bg-gray-50 max-w-full">
                                                <img data-preview-img="novo-servico" src="" alt="Preview da imagem"
                                                    class="max-h-[180px] w-auto max-w-full object-contain mx-auto block" />
                                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs md:text-sm font-semibold p-2 text-center">
                                                    Clique para trocar a imagem
                                                </div>
                                            </div>
                                            <span class="text-xs text-gray-500 font-medium">Clique para escolher outra imagem</span>
                                        </div>
                                    </label>

                                    <!-- Confere com o nome do arquivo (estilo Adicionar Produto) e opção de remover -->
                                    <div data-info-wrapper="novo-servico" class="hidden flex-row items-center justify-between gap-3 px-1 animate-fadeItem">
                                        <span data-info="novo-servico-imagem" class="font-sans text-sm font-semibold text-green-600 truncate flex items-center gap-1.5">
                                        </span>
                                        <button type="button" data-remove-img="novo-servico"
                                            class="text-xs font-semibold text-red-500 hover:text-red-700 hover:underline shrink-0">
                                            Remover
                                        </button>
                                    </div>
                                </div>

                                <button type="submit"
                                    class="flex flex-row items-center justify-center px-8 py-[10px] h-[52px] bg-green-600 rounded-[5px] shadow-sm hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all w-full md:w-auto md:self-end">
                                    <span
                                        class="font-sans font-semibold text-lg md:text-[22px] leading-[27px] text-white">
                                        Cadastrar Serviço
                                    </span>
                                </button>
                            </form>
                        </div>

                        <div class="hidden sm:col-span-3 flex-col gap-6 peer-checked/atualizar:flex animate-fadeItem">
                            <form action="/administrador/servicos/atualizar" method="POST" enctype="multipart/form-data"
                                class="flex flex-col gap-6 w-full">

                                <div class="flex flex-col md:flex-row flex-wrap gap-6 w-full">
                                    <div class="flex flex-col gap-[10px] flex-1 min-w-[250px]">
                                        <label for="servico-select"
                                            class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                            Escolha o Serviço
                                        </label>
                                        <div class="relative">
                                            <select id="servico-select" name="servicoId" required
                                                class="px-5 py-[10px] w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none bg-white cursor-pointer appearance-none focus:ring-4 focus:ring-green-600/30 transition-all">
                                                <option value="" disabled selected>Selecione um serviço...</option>
                                                <% if (locals.servicos && servicos.length> 0) { %>
                                                    <% servicos.forEach(servico=> { %>
                                                        <option value="<%= servico.id %>">
                                                            <%= servico.nome %>
                                                        </option>
                                                        <% }) %>
                                                            <% } %>
                                            </select>
                                            <img src="/images/icons/arrow-down.svg"
                                                class="absolute right-4 top-1/2 -translate-y-1/2 w-6 h-6 pointer-events-none opacity-70"
                                                alt="Seta" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-[10px] flex-1 min-w-[180px]">
                                        <label for="tempo-input"
                                            class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                            Nova Duração (min)
                                        </label>
                                        <input type="text" maxlength="8" id="tempo-input" name="duracao"
                                            placeholder="Ex: 90 min" required
                                            class="px-5 py-[10px] w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400" />
                                    </div>

                                    <div class="flex flex-col gap-[10px] flex-1 min-w-[180px]">
                                        <label for="preco-input"
                                            class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                            Novo Preço (R$)
                                        </label>
                                        <input type="text" maxlength="11" id="preco-input" name="preco"
                                            placeholder="R$ 0,00" required
                                            class="px-5 py-[10px] w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400" />
                                    </div>
                                </div>

                                <div class="flex flex-col gap-[10px]">
                                    <label for="atualizar-servico-descricao"
                                        class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                        Nova Descrição
                                    </label>
                                    <textarea id="atualizar-servico-descricao" name="descricao" maxlength="500" rows="4"
                                        placeholder="Deixe em branco para manter a descrição atual..."
                                        class="px-5 py-3 w-full border-2 border-gray-300 focus:border-green-600 rounded-[5px] shadow-sm font-medium text-lg text-gray-600 outline-none resize-none focus:ring-4 focus:ring-green-600/30 transition-all placeholder:text-gray-400"></textarea>
                                </div>

                                <div class="flex flex-col gap-[10px]">
                                    <span class="font-sans font-semibold text-lg md:text-[22px] text-gray-700">
                                        Nova Imagem do Serviço
                                    </span>
                                    <input type="file" id="atualizar-servico-imagem" name="imagem" accept="image/*"
                                        class="peer sr-only" />
                                    <label for="atualizar-servico-imagem"
                                        class="cursor-pointer relative flex flex-col items-center justify-center min-h-[140px] px-4 py-6 border-2 border-dashed border-gray-400 rounded-[10px] hover:border-green-500 hover:bg-green-50/50 peer-focus-visible:border-green-500 peer-focus-visible:ring-4 peer-focus-visible:ring-green-600/30 transition-all overflow-hidden group">
                                        
                                        <!-- Estado Inicial: Sem imagem selecionada -->
                                        <div data-placeholder="atualizar-servico" class="flex flex-col items-center justify-center gap-3">
                                            <img src="/images/icons/administrador/plus-slide.svg" alt="Adicionar imagem"
                                                class="w-8 h-8 opacity-60 group-hover:opacity-100 transition-opacity" />
                                            <span class="font-sans font-medium text-sm md:text-base text-gray-500 text-center">
                                                Clique para trocar a imagem (opcional, mantém a atual se vazio)
                                            </span>
                                        </div>

                                        <!-- Estado com Preview: Imagem selecionada -->
                                        <div data-preview-wrapper="atualizar-servico" class="hidden flex-col items-center justify-center gap-2 w-full animate-fadeItem">
                                            <div class="relative rounded-[8px] overflow-hidden shadow-sm border border-gray-200 bg-gray-50 max-w-full">
                                                <img data-preview-img="atualizar-servico" src="" alt="Preview da imagem"
                                                    class="max-h-[180px] w-auto max-w-full object-contain mx-auto block" />
                                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs md:text-sm font-semibold p-2 text-center">
                                                    Clique para trocar a imagem
                                                </div>
                                            </div>
                                            <span class="text-xs text-gray-500 font-medium">Clique para escolher outra imagem</span>
                                        </div>
                                    </label>

                                    <!-- Confere com o nome do arquivo (estilo Adicionar Produto) e opção de remover -->
                                    <div data-info-wrapper="atualizar-servico" class="hidden flex-row items-center justify-between gap-3 px-1 animate-fadeItem">
                                        <span data-info="atualizar-servico-imagem" class="font-sans text-sm font-semibold text-green-600 truncate flex items-center gap-1.5">
                                        </span>
                                        <button type="button" data-remove-img="atualizar-servico"
                                            class="text-xs font-semibold text-red-500 hover:text-red-700 hover:underline shrink-0">
                                            Remover
                                        </button>
                                    </div>
                                </div>

                                <button type="submit"
                                    class="flex flex-row items-center justify-center px-8 py-[10px] h-[52px] bg-green-600 rounded-[5px] shadow-sm hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all w-full md:w-auto md:self-end">
                                    <span
                                        class="font-sans font-semibold text-lg md:text-[22px] leading-[27px] text-white">
                                        Atualizar Serviço
                                    </span>
                                </button>
                            </form>
                        </div>

                        <div class="hidden sm:col-span-3 flex-col gap-6 peer-checked/deletar:flex animate-fadeItem">
                            <div class="flex flex-col gap-2">
                                <h3 class="font-sans font-semibold text-xl md:text-2xl text-gray-800">
                                    Selecione o serviço que deseja deletar
                                </h3>
                                <p class="font-sans font-medium text-sm md:text-base text-gray-600">
                                    Clique no ícone vermelho no canto do card para remover um serviço.
                                </p>
                            </div>

                            <div data-content-services-delete
                                class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 w-full">
                                <% if (locals.servicos && servicos.length > 0) { %>
                                    <% servicos.forEach(servico => { %>
                                        <%
                                            const serviceSlug = (servico.nome || '')
                                                .toLowerCase()
                                                .normalize('NFD')
                                                .replace(/[\u0300-\u036f]/g, '')
                                                .replace(/\s+e\s+/g, '-')
                                                .replace(/\s+/g, '-')
                                                .replace(/[^a-z0-9-]/g, '');
                                            const serviceDefaultImg = (serviceSlug === 'banho-tosa' || serviceSlug === 'vacinacao' || serviceSlug === 'cirurgia')
                                                ? `/images/services/${serviceSlug}.png`
                                                : '/images/services/banho-tosa.png';
                                        %>
                                        <article data-service-card
                                            class="service-card relative flex flex-col overflow-hidden transition-all duration-300">
                                            <button type="button" data-button="deleteService"
                                                data-service-id="<%= servico.id %>"
                                                data-service-name="<%= servico.nome %>"
                                                aria-label="Deletar serviço <%= servico.nome %>"
                                                title="Deletar serviço"
                                                class="absolute top-4 left-4 z-10 flex items-center justify-center w-10 h-10 bg-white rounded-full shadow-md border border-red-light hover:bg-red-light focus:outline-none focus:ring-4 focus:ring-red-alert/30 transition-colors">
                                                <img src="/images/icons/administrador/delete-slide.svg" alt=""
                                                    class="w-4 h-4" />
                                            </button>

                                            <img src="/servicos/imagem/<%= servico.id %>"
                                                onerror="this.onerror=null; this.src='<%= serviceDefaultImg %>';"
                                                alt="<%= servico.nome || 'Serviço' %>"
                                                class="w-full h-[300px] object-cover" />

                                            <div class="p-[30px] flex-1 flex flex-col gap-[10px]">
                                                <h3 class="text-2xl md:text-3xl font-semibold text-gray-800">
                                                    <%= servico.nome %>
                                                </h3>
                                                <p class="text-lg md:text-[22px] font-normal leading-snug text-gray-700">
                                                    <%= servico.descricao || 'Descrição do serviço.' %>
                                                </p>
                                            </div>
                                        </article>
                                    <% }) %>
                                <% } else { %>
                                    <div class="md:col-span-2 xl:col-span-3 flex flex-col items-center justify-center py-12 px-6 text-center bg-gray-50 rounded-[15px] border border-gray-200">
                                        <div class="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center mb-4">
                                            <img src="/images/icons/calendar_clock_green.svg" alt="" class="w-8 h-8" />
                                        </div>
                                        <p class="text-xl md:text-2xl font-medium text-gray-700">
                                            Nenhum serviço cadastrado para deletar.
                                        </p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <section id="section-agendamentos" data-tab-content
                class="animate-fadeLeft opacity-0 hidden w-full max-w-[1400px] mt-10 md:mt-20 flex-col gap-8">
                
                <!-- Cabeçalho da Seção com Ação Global -->
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 w-full">
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-3">
                            <span class="w-3.5 h-3.5 rounded-full bg-green-600"></span>
                            <h2 class="font-sans font-bold text-xl md:text-3xl leading-tight md:leading-[40px] text-green-700">
                                Solicitações de Agendamento
                            </h2>
                        </div>
                        <p class="font-sans font-medium text-base md:text-lg text-gray-600 max-w-2xl">
                            Analise as solicitações pendentes e escolha entre aceitar com o 
                            (<strong class="text-green-700">✔</strong>) 
                            ou recusar com o (<strong class="text-red-alert">✖</strong>). 
                            Ao confirmar, um e-mail personalizado com o editor Quill é enviado ao cliente.
                        </p>
                    </div>
                </div>

                <!-- Barra de Busca e Filtros de Status -->
                <div class="my-5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 p-4 bg-white rounded-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.1)] w-full">
                    <div class="relative flex-1 min-w-[240px]">
                        <input data-input="searchAppointments" type="text" maxlength="60"
                            placeholder="Buscar por cliente, pet, serviço ou e-mail..."
                            class="w-full pl-10 pr-4 py-2.5 border-2 border-gray-300 rounded-[8px] font-medium text-sm md:text-base text-gray-700 outline-none focus:border-green-600 focus:ring-4 focus:ring-green-600/20 transition-all placeholder:text-gray-400" />
                        <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                </div>

                <!-- Container onde os cards de agendamento são inseridos dinamicamente -->
                <div data-content-appointment-requests class="flex flex-col gap-5 w-full"
                    aria-live="polite">
                    <%
                        function formatarDataBR(dataVal) {
                            if (!dataVal) return 'Data não informada';
                            if (dataVal instanceof Date) {
                                const d = String(dataVal.getDate()).padStart(2, '0');
                                const m = String(dataVal.getMonth() + 1).padStart(2, '0');
                                const y = dataVal.getFullYear();
                                return `${d}/${m}/${y}`;
                            }
                            const str = String(dataVal).split('T')[0];
                            const partes = str.split('-');
                            if (partes.length === 3) {
                                return `${partes[2]}/${partes[1]}/${partes[0]}`;
                            }
                            return str;
                        }

                        function formatarHoraBR(horaVal) {
                            if (!horaVal) return 'Horário a definir';
                            const partes = String(horaVal).split(':');
                            if (partes.length >= 2) {
                                return `${partes[0]}:${partes[1]}`;
                            }
                            return horaVal;
                        }

                        function formatarTelefoneBR(tel) {
                            if (!tel) return 'Telefone não informado';
                            const clean = String(tel).replace(/\D/g, '');
                            if (clean.length === 11) {
                                return `(${clean.slice(0, 2)}) ${clean.slice(2, 7)}-${clean.slice(7)}`;
                            }
                            if (clean.length === 10) {
                                return `(${clean.slice(0, 2)}) ${clean.slice(2, 6)}-${clean.slice(6)}`;
                            }
                            return tel;
                        }

                        const listaAgendamentos = (locals.agendamentos && Array.isArray(agendamentos))
                            ? agendamentos.filter(item => {
                                const ag = item.agenda || item;
                                return ag.pendente === true || ag.pendente === 1 || ag.pendente === '1' || ag.pendente === 'true';
                            })
                            : [];
                    %>

                    <% if (listaAgendamentos.length > 0) { %>
                        <% listaAgendamentos.forEach(item => { 
                            const ag = item.agenda || item;
                            const usr = item.usuario || {};
                            const srv = item.service_infos || item.service || {};

                            const id = ag.id;
                            const isPending = (ag.pendente === true || ag.pendente === 1 || ag.pendente === '1' || ag.pendente === 'true');
                            const clientName = ag.nome || usr.nome || 'Cliente não informado';
                            const email = usr.email || '';
                            const telefone = ag.telefone || usr.telefone || '';
                            const petName = ag.nomePet || 'Pet';
                            const raca = ag.raca || '';
                            const serviceName = srv.nome || srv.name || item.service_nome || 'Serviço Veterinário';
                            const dateFormatted = formatarDataBR(ag.dateAgendamento);
                            const hourFormatted = formatarHoraBR(ag.hourAgendamento);
                            const hasTranslado = Boolean(ag.buscarResidencia);
                            const enderecoBusca = ag.endereco || 'Atendimento presencial na clínica';
                            const observation = ag.observation || '';
                            const userId = usr.id || ag.fk_user;
                            const hasAvatar = Boolean(usr.avatar);
                        %>
                            <article
                                data-appointment-card
                                data-appointment-id="<%= id %>"
                                data-client-name="<%= clientName %>"
                                data-email="<%= email %>"
                                data-phone="<%= telefone %>"
                                data-pet="<%= petName %>"
                                data-service="<%= serviceName %>"
                                data-service-id="<%= srv.id || ag.fk_service || '' %>"
                                data-date="<%= dateFormatted %>"
                                data-hour="<%= hourFormatted %>"
                                data-translado="<%= hasTranslado ? 'true' : 'false' %>"
                                data-pending="<%= isPending ? 'true' : 'false' %>"
                                class="animate-fadeItem flex flex-col justify-between gap-5 w-full p-5 sm:p-7 bg-white rounded-[12px] border-l-[6px] <%= isPending ? 'border-orange' : 'border-green-500' %> shadow-[0px_2px_8px_0px_rgba(0,0,0,0.06)] hover:shadow-md transition-all"
                            >
                                <!-- Cabeçalho do Card -->
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-4">
                                    <div class="flex items-center gap-3.5">
                                        <% if (hasAvatar && userId) { %>
                                            <img
                                                src="/usuario/avatar/<%= userId %>"
                                                alt="<%= clientName %>"
                                                class="w-12 h-12 rounded-full object-cover shrink-0 border border-green-200"
                                                onerror="this.onerror=null; this.src='/images/icons/options/user-default.svg';"
                                            />
                                        <% } else { %>
                                            <span class="flex items-center justify-center shrink-0 w-12 h-12 rounded-full bg-green-50 text-green-700 border border-green-200 font-sans font-bold text-xl uppercase select-none">
                                                <%= clientName.charAt(0) %>
                                            </span>
                                        <% } %>

                                        <div class="flex flex-col">
                                            <h3 class="font-sans font-bold text-lg md:text-xl text-gray-800 leading-tight">
                                                <%= clientName %>
                                            </h3>
                                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs md:text-sm text-gray-500 mt-0.5">
                                                <% if (email) { %>
                                                    <span class="flex items-center gap-1 font-medium text-gray-600">✉ <%= email %></span>
                                                <% } %>
                                                <% if (email && telefone) { %>
                                                    <span>•</span>
                                                <% } %>
                                                <% if (telefone) { %>
                                                    <span>📞 <%= formatarTelefoneBR(telefone) %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Status Badge -->
                                    <div class="shrink-0" data-status-container="<%= id %>">
                                        <% if (!isPending) { %>
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs md:text-sm font-semibold bg-green-100 text-green-700 border border-green-300">
                                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                </svg>
                                                Aceito • E-mail Enviado
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs md:text-sm font-semibold bg-orange-light text-orange border border-orange/30">
                                                <span class="w-2 h-2 rounded-full bg-orange animate-pulse"></span>
                                                Pendente de Avaliação
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Corpo com Grid de Informações -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
                                    <div class="flex flex-col">
                                        <span class="text-xs text-gray-400 uppercase font-semibold">Pet & Raça</span>
                                        <span class="text-gray-800 font-bold flex items-center gap-1.5 mt-0.5">
                                            <img src="/images/icons/options/pets/dog.svg" alt="Pet" class="w-4 h-4" />
                                            <%= petName %> <% if (raca) { %><span class="text-xs text-gray-500 font-normal">(<%= raca %>)</span><% } %>
                                        </span>
                                    </div>

                                    <div class="flex flex-col">
                                        <span class="text-xs text-gray-400 uppercase font-semibold">Serviço</span>
                                        <span class="text-gray-800 font-semibold mt-0.5"><%= serviceName %></span>
                                    </div>

                                    <div class="flex flex-col">
                                        <span class="text-xs text-gray-400 uppercase font-semibold">Data & Horário</span>
                                        <span class="text-gray-800 font-bold flex items-center gap-1 mt-0.5">
                                            <img src="/images/icons/calender/hour.svg" alt="Horário" class="w-4 h-4 opacity-75" />
                                            <%= dateFormatted %> às <%= hourFormatted %>
                                        </span>
                                    </div>

                                    <div class="flex flex-col">
                                        <span class="text-xs text-gray-400 uppercase font-semibold">Transporte</span>
                                        <span class="text-gray-800 font-medium mt-0.5">
                                            <%= hasTranslado ? '🚐 Buscar na residência' : '🏥 Na clínica' %>
                                        </span>
                                    </div>

                                    <% if (hasTranslado) { %>
                                        <div class="flex flex-col sm:col-span-2 lg:col-span-4 bg-gray-50 p-2.5 rounded-lg border border-gray-200">
                                            <span class="text-xs text-gray-500 font-semibold">Endereço de Busca:</span>
                                            <span class="text-gray-700 text-xs sm:text-sm font-medium mt-0.5 flex items-center gap-1">
                                                <img src="/images/icons/options/endereco/house.svg" class="w-3.5 h-3.5" alt="Casa" />
                                                <%= enderecoBusca %>
                                            </span>
                                        </div>
                                    <% } %>

                                    <% if (observation) { %>
                                        <div class="flex flex-col sm:col-span-2 lg:col-span-4 text-xs sm:text-sm">
                                            <span class="text-xs text-gray-400 uppercase font-semibold">Observações do Cliente:</span>
                                            <span class="text-gray-700 italic mt-0.5">"<%= observation %>"</span>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Rodapé com Ações -->
                                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-gray-100">
                                    <span class="text-xs text-gray-400 font-medium">
                                        Solicitação ID: #<%= id %>
                                    </span>

                                    <div class="flex items-center gap-3 w-full sm:w-auto justify-end" data-actions-container="<%= id %>">
                                        <% if (!isPending) { %>
                                            <button
                                                type="button"
                                                data-action="renotify"
                                                data-id="<%= id %>"
                                                class="text-xs font-semibold text-green-600 hover:text-green-700 hover:underline outline-none cursor-pointer"
                                            >
                                                Enviar novo e-mail ao cliente
                                            </button>
                                        <% } else { %>
                                            <!-- Botão Recusar (X) -->
                                            <button
                                                type="button"
                                                data-action="reject"
                                                data-id="<%= id %>"
                                                class="flex-1 sm:flex-initial flex items-center justify-center gap-2 px-5 py-2.5 bg-red-alert hover:opacity-90 text-white rounded-lg font-sans font-semibold text-sm shadow-sm transition-all focus:outline-none focus:ring-4 focus:ring-red-alert/40 cursor-pointer"
                                            >
                                                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                                <span>Recusar</span>
                                            </button>

                                            <!-- Botão Aceitar (Confere ✔) -->
                                            <button
                                                type="button"
                                                data-action="accept"
                                                data-id="<%= id %>"
                                                class="flex-1 sm:flex-initial flex items-center justify-center gap-2 px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-lg font-sans font-semibold text-sm shadow-sm transition-all focus:outline-none focus:ring-4 focus:ring-green-500/40 cursor-pointer"
                                            >
                                                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                </svg>
                                                <span>Aceitar</span>
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div data-appointment-empty class="flex flex-col items-center justify-center p-12 bg-white rounded-[12px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] text-center gap-3 animate-fadeItem">
                            <img src="/images/icons/calendar_clock_green.svg" alt="Sem agendamentos" class="w-12 h-12" />
                            <h4 class="font-sans font-bold text-lg text-gray-700">Nenhuma solicitação encontrada</h4>
                            <p class="font-sans text-sm text-gray-500 max-w-sm">
                                Não há solicitações de agendamento registradas no momento.
                            </p>
                        </div>
                    <% } %>
                </div>
            </section>

            <section id="section-produtos" data-tab-content
                class="animate-fadeLeft opacity-0 hidden w-full max-w-[1400px] mt-10 md:mt-20">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center w-full gap-5">
                    <h2
                        class="font-sans font-bold text-xl md:text-3xl leading-tight md:leading-[40px] text-green-700 whitespace-nowrap">
                        Gestão de Produtos
                    </h2>
                    <button type="button" data-button="addProduct"
                        class="flex flex-row items-center gap-[10px] md:gap-[30px] px-5 py-3 md:px-[36px] md:py-[16px] bg-green-400 rounded-[15px] hover:bg-green-500 focus:outline-none focus:ring-4 focus:ring-green-400/50 transition-all shrink-0 shadow-sm">
                        <img src="/images/icons/administrador/plus-product.svg" alt="Novo produto"
                            class="w-6 h-6 md:w-[30px] md:h-[30px]" />
                        <span class="font-sans font-semibold text-lg md:text-2xl uppercase text-gray-50">
                            Novo produto
                        </span>
                    </button>
                </div>

                <div
                    class="mt-5 md:mt-10 flex flex-col p-7 md:p-[60px] bg-white rounded-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] gap-10 md:gap-[60px] w-full overflow-hidden">
                    <div
                        class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-3 xl:gap-10 w-full">
                        <div
                            class="relative flex flex-row justify-between items-center px-4 py-2 md:px-[36px] md:py-[12px] bg-white border-4 border-gray-300 focus-within:border-green-400 focus-within:ring-4 focus-within:ring-green-400/20 transition-all rounded-[10px] w-full flex-1">
                            <input data-input="filterProduct" type="text" maxlength="50" placeholder="Busca por nome..."
                                class="bg-transparent w-full outline-none font-medium text-base md:text-2xl text-gray-500 placeholder:text-gray-500" />
                            <img src="/images/icons/search.svg" alt="Buscar" class="w-6 h-6 md:w-[32px] md:h-[33px]" />
                        </div>

                        <div class="relative shrink-0 min-w-fit md:min-w-[400px] w-full md:w-auto">
                            <select data-select="typeProduct"
                                class="w-full pl-8 pr-8 xs:pr-20 py-3 md:py-[18px] bg-gray-100 focus:bg-white focus:outline-none focus:ring-4 focus:ring-green-400/50 transition-all rounded-[10px] font-semibold text-sm xs:text-base md:text-2xl uppercase text-gray-700 cursor-pointer appearance-none">
                                <option value="all" selected>
                                    Todas as Categorias
                                </option>
                                <option value="ração">Ração</option>
                                <option value="brinquedos">
                                    Brinquedos
                                </option>
                                <option value="medicamentos">
                                    Medicamentos
                                </option>
                                <option value="acessórios">
                                    Acessórios
                                </option>
                                <option value="higiene">Higiene</option>
                            </select>
                            <img src="/images/icons/arrow-down.svg" alt="Seta para baixo"
                                class="hidden xs:block absolute right-5 top-1/2 -translate-y-1/2 w-10 pointer-events-none" />
                        </div>
                    </div>

                    <div class="scroll w-full overflow-x-auto pb-1">
                        <table
                            class="table-caption w-full min-w-[1200px] xl:min-w-[1400px] text-left border-collapse [&_th]:px-4 lg:[&_th]:px-6 [&_td]:px-4 lg:[&_td]:px-6">
                            <thead>
                                <tr
                                    class="border-b-[3px] border-gray-100 *:pb-5 *:font-semibold *:text-sm *:md:text-lg *:lg:text-xl *:leading-[32px] *:text-gray-700 *:whitespace-nowrap">
                                    <th>Produto</th>
                                    <th>Categoria</th>
                                    <th>Preço (R$)</th>
                                    <th>Descrição Longa</th>
                                    <th>Descrição Curta</th>
                                    <th class="text-center">Editar</th>
                                    <th class="text-center">Excluir</th>
                                </tr>
                            </thead>
                            <tbody data-content-products="table">
                                <% if (!locals.produtos || produtos.length===0) { %>
                                    <tr>
                                        <td colspan="7"
                                            class="min-w-[1200px] xl:min-w-[1400px] text-center p-6 text-gray-500 font-medium text-lg">
                                            Nenhum produto encontrado.</td>
                                    </tr>
                                    <% } else { %>
                                        <% produtos.forEach(produto=> { %>
                                            <tr data-id="<%= produto.id %>"
                                                data-name="<%= produto.nome %>"
                                                data-category="<%= produto.categoria %>"
                                                data-price="<%= produto.preco %>"
                                                data-short-description="<%= produto.short_description || '' %>"
                                                data-long-description="<%- (produto.long_description || '').replace(/"/g, '&quot;') %>"
                                                class="animate-fadeItem border-b-[3px] border-gray-100 *:text-lg *:leading-[32px] *:text-gray-700 transition-colors">
                                                <td class="max-w-0 truncate w-[20%]">
                                                    <%= produto.nome %>
                                                </td>
                                                <td class="capitalize">
                                                    <%= produto.categoria %>
                                                </td>
                                                <td class="whitespace-nowrap font-medium text-green-700">
                                                    <%= "R$ " + Number(produto.preco || 0).toFixed(2).replace('.', ',') %>
                                                </td>
                                                <td class="w-[25%] max-w-[240px] xl:max-w-[320px]">
                                                    <div class="truncate" title="<%= (produto.long_description || '').replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim() %>">
                                                        <%= (produto.long_description || '').replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim() %>
                                                    </div>
                                                </td>
                                                <td class="w-[25%] max-w-[200px] xl:max-w-[260px]">
                                                    <div class="truncate" title="<%= produto.short_description || '' %>">
                                                        <%= produto.short_description || '' %>
                                                    </div>
                                                </td>
                                                <td class="py-5 text-center">
                                                    <button type="button" data-button="editProduct"
                                                        class="hover:opacity-80 transition-opacity mx-auto flex cursor-pointer">
                                                        <img src="../images/icons/administrador/edit-blue.svg"
                                                            alt="Editar" class="w-6 h-6 md:w-[35px] md:h-[38px]">
                                                    </button>
                                                </td>
                                                <td class="py-5 text-center">
                                                    <button type="button" data-button="deleteProduct"
                                                        class="p-4 hover:opacity-80 transition-opacity mx-auto flex cursor-pointer">
                                                        <img src="../images/icons/administrador/delete-product.svg"
                                                            alt="Excluir" class="w-6 h-6 md:w-[37px] md:h-[38px]">
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                        <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="section-relatorios" data-tab-content
                class="animate-fadeLeft opacity-0 hidden w-full max-w-[1400px] mt-10 md:mt-20">
                <div class="w-full flex flex-col sm:flex-row items-start sm:items-center gap-6">
                    <h2 class="font-sans font-bold text-2xl md:text-3xl text-gray-900 whitespace-nowrap">
                        Gestão de Usuários
                    </h2>

                    <div
                        class="relative flex items-center w-full bg-white border border-gray-300 rounded-[8px] px-3.5 py-2 focus-within:border-green-600 focus-within:ring-2 focus-within:ring-green-600/20 transition-all shadow-xs">
                        <svg class="w-4 h-4 text-gray-400 mr-2.5 shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input data-input="searchUsers" type="text" maxlength="50" placeholder="Pesquisar usuários..."
                            class="w-full bg-transparent outline-none font-sans text-sm md:text-base text-gray-700 placeholder:text-gray-400" />
                    </div>
                </div>

                <div class="mt-4 w-full bg-white rounded-[12px] border border-gray-300 overflow-hidden shadow-sm">
                    <div class="w-full overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[700px] animate-fadeLeft">
                            <thead>
                                <tr class="border-b border-gray-300 bg-white">
                                    <th
                                        class="py-3.5 px-6 font-sans font-bold text-base md:text-lg text-gray-900 w-[90px] text-center">
                                        Foto</th>
                                    <th class="py-3.5 px-6 font-sans font-bold text-base md:text-lg text-gray-900">Nome
                                        Completo</th>
                                    <th class="py-3.5 px-6 font-sans font-bold text-base md:text-lg text-gray-900">
                                        E-mail</th>
                                    <th class="py-3.5 px-6 font-sans font-bold text-base md:text-lg text-gray-900">
                                        Telefone</th>
                                </tr>
                            </thead>
                            <tbody data-content-users="table">
                                <% if (locals.usuarios && usuarios.length > 0) { %>
                                    <% usuarios.slice(0, 10).forEach((user, index) => { %>
                                        <% 
                                            const cleanPhone = String(user.telefone || '').replace(/\D/g, '');
                                            const formattedPhone = cleanPhone.length === 11 ? `(${cleanPhone.slice(0, 2)}) ${cleanPhone.slice(2, 7)}-${cleanPhone.slice(7)}` : (cleanPhone.length === 10 ? `(${cleanPhone.slice(0, 2)}) ${cleanPhone.slice(2, 6)}-${cleanPhone.slice(6)}` : user.telefone);
                                        %>
                                        <tr class="<%= index % 2 === 1 ? 'bg-row-zebra' : 'bg-white' %> hover:opacity-90 transition-colors"
                                            style="<%= index % 2 === 1 ? 'background-color: #E2EAE4;' : '' %>">
                                            <td class="py-3 px-6 text-center w-[90px]">
                                                <img src="<%= user.has_avatar ? `/usuario/avatar/${user.id}` : '/images/icons/options/user-default.svg' %>"
                                                    alt="<%= user.nome %>"
                                                    class="w-10 h-10 md:w-11 md:h-11 rounded-full object-cover mx-auto"
                                                    onerror="this.src='/images/icons/options/user-default.svg';" />
                                            </td>
                                            <td class="py-3 px-6 font-medium text-gray-900 text-base md:text-lg">
                                                <%= user.nome %>
                                            </td>
                                            <td class="py-3 px-6 text-gray-800 text-base md:text-lg">
                                                <%= user.email %>
                                            </td>
                                            <td class="py-3 px-6 text-gray-800 text-base md:text-lg whitespace-nowrap">
                                                <%= formattedPhone %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4"
                                            class="text-center py-10 text-gray-500 font-medium text-base">
                                            Carregando usuários...
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div data-pagination="users" class="<%= (locals.usuarios && usuarios.length > 10) ? 'flex' : 'hidden' %> items-center justify-center gap-1.5 mt-5 mb-2">
                    <button type="button" data-action="prev"
                        class="px-3 py-1 text-sm font-medium text-gray-700 hover:bg-gray-200 rounded transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Anterior</button>
                    <button type="button" data-page="1"
                        class="px-3 py-1 text-sm font-semibold text-white bg-green-700 rounded transition-all">1</button>
                    <button type="button" data-action="next"
                        class="px-3 py-1 text-sm font-medium text-gray-700 hover:bg-gray-200 rounded transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Próximo</button>
                </div>
            </section>
        </main>
    </div>

    <!-- form add product -->
    <div data-modal="addProduct"
        class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50 animate-fadeItem">
        <div
            class="relative w-[95%] max-w-[720px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="addProduct"
                class="relative max-h-[90vh] overflow-y-auto scroll bg-white p-6 md:p-10 flex flex-col gap-6 md:gap-8">
                <button type="button" data-button="closeFormProduct"
                    class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar Formulário" />
                </button>

                <h3 class="font-sans font-bold text-xl md:text-2xl text-green-600 pr-10">
                    Adicionar Novo Produto
                </h3>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-product-name"
                        class="font-sans font-semibold text-base md:text-lg text-gray-700">Nome do Produto</label>
                    <input data-input="product-name" id="input-product-name" type="text" name="name"
                        placeholder="Ex: Ração Golden Cães Adultos" maxlength="35" required
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                </div>

                <div class="flex flex-col sm:flex-row gap-6">
                    <div class="flex flex-col gap-[10px] flex-1">
                        <label for="select-product-category"
                            class="font-sans font-semibold text-base md:text-lg text-gray-700">Categoria</label>
                        <div class="relative">
                           <select data-select-new="productCategory" id="select-product-category" name="categoria" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600">
                                <option value="" disabled selected>Selecione uma categoria</option>
                                <option value="Ração">Ração</option>
                                <option value="Brinquedos">Brinquedos</option>
                                <option value="Medicamentos">Medicamentos</option>
                                <option value="Acessórios">Acessórios</option>
                                <option value="Higiene">Higiene</option>
                            </select>
                            <img src="/images/icons/arrow-down.svg" alt="Seta para baixo"
                                class="absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 pointer-events-none" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-[10px] sm:w-[200px]">
                        <label for="input-product-price"
                            class="font-sans font-semibold text-base md:text-lg text-gray-700">Preço (R$)</label>
                        <input data-input="priceProduct" id="input-product-price" type="text" name="price" min="0"
                            step="0.01" placeholder="R$ 0,00" maxlength="11" required
                            class="appearance-none px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                </div>

                <div class="flex flex-col gap-[10px]">
                    <label for="textarea-short-description"
                        class="font-sans font-semibold text-base md:text-lg text-gray-700">Descrição Curta</label>
                    <textarea data-textarea="shortDescription" id="textarea-short-description" name="shortDescription"
                        maxlength="80" placeholder="Digite a descrição curta do produto..."
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none resize-none min-h-[70px] focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400"
                        required></textarea>
                </div>

                <div class="flex flex-col gap-[10px]">
                    <label for="textarea-long-description"
                        class="font-sans font-semibold text-base md:text-lg text-gray-700">Descrição Longa</label>
                    <div
                        class="quill-wrapper rounded-lg border-2 border-gray-300 focus-within:border-green-500 focus-within:ring-4 focus-within:ring-green-500/20 transition-all bg-white overflow-hidden">
                        <div data-quill-editor="longDescription" class="min-h-[120px]"></div>
                    </div>
                    <textarea data-textarea="longDescription" id="textarea-long-description" name="longDescription"
                        class="hidden"></textarea>
                    <p class="font-sans text-xs md:text-sm text-gray-500">
                        • Use os controles de formatação para títulos, negrito, listas e links no editor de texto.
                    </p>
                </div>

                <!-- Imagem Principal -->
                <div class="flex flex-col gap-[10px]" data-image-box="product-main-image">
                    <p class="font-sans font-semibold text-base md:text-lg text-gray-700">Imagem Principal</p>
                    <label for="input-main-image"
                        class="cursor-pointer relative flex flex-col items-center justify-center min-h-[140px] px-4 py-6 border-2 border-dashed border-gray-400 rounded-[10px] hover:border-green-500 hover:bg-green-50/50 transition-all overflow-hidden group">
                        
                        <!-- Estado Inicial: Sem imagem -->
                        <div data-placeholder="product-main-image" class="flex flex-col items-center justify-center gap-3">
                            <img src="/images/icons/administrador/plus-slide.svg" alt="Adicionar imagem"
                                class="w-8 h-8 opacity-60 group-hover:opacity-100 transition-opacity" />
                            <span class="font-sans font-medium text-sm md:text-base text-gray-500 text-center">
                                Clique para selecionar a imagem principal
                            </span>
                        </div>

                        <!-- Estado com Preview: Imagem selecionada -->
                        <div data-preview-wrapper="product-main-image" class="hidden flex-col items-center justify-center gap-2 w-full animate-fadeItem">
                            <div class="relative rounded-[8px] overflow-hidden shadow-sm border border-gray-200 bg-gray-50 max-w-full">
                                <img data-preview-img="product-main-image" src="" alt="Preview da imagem principal"
                                    class="max-h-[180px] w-auto max-w-full object-contain mx-auto block" />
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs md:text-sm font-semibold p-2 text-center">
                                    Clique para trocar a imagem
                                </div>
                            </div>
                            <span class="text-xs text-gray-500 font-medium">Clique para escolher outra imagem</span>
                        </div>
                    </label>
                    <input data-input="imageMainProduct" id="input-main-image" type="file" name="mainImage"
                        accept="image/*" class="peer sr-only" />

                    <!-- Confere com o nome do arquivo (estilo Adicionar Produto) e opção de remover -->
                    <div data-info-wrapper="product-main-image" class="hidden flex-row items-center justify-between gap-3 px-1 animate-fadeItem">
                        <span data-info="mainImage" class="font-sans text-sm font-semibold text-green-600 truncate flex items-center gap-1.5"></span>
                        <button type="button" data-remove-img="product-main-image"
                            class="text-xs font-semibold text-red-500 hover:text-red-700 hover:underline shrink-0">
                            Remover
                        </button>
                    </div>
                </div>

                <!-- Imagens do Slide (Galeria Reordenável Visualmente) -->
                <div class="flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <p class="font-sans font-semibold text-base md:text-lg text-gray-700">Imagens do Slide</p>
                        <span data-slide-count-badge class="text-xs font-semibold px-2.5 py-1 bg-green-100 text-green-800 rounded-full hidden">
                            0 slides
                        </span>
                    </div>

                    <!-- Botão/Área para adicionar imagens ao slide -->
                    <label for="input-slide-images"
                        class="cursor-pointer flex flex-col items-center justify-center gap-2 px-4 py-5 border-2 border-dashed border-gray-400 rounded-[10px] hover:border-green-500 hover:bg-green-50/50 transition-all group">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <img src="/images/icons/administrador/plus-slide.svg" alt="Adicionar imagens"
                                class="w-6 h-6 opacity-60 group-hover:opacity-100 transition-opacity" />
                            <span class="font-sans font-medium text-sm md:text-base text-gray-600 group-hover:text-green-700 transition-colors">
                                Clique ou arraste para adicionar fotos ao slide
                            </span>
                        </div>
                        <span class="font-sans text-xs text-gray-400">
                            Selecione uma ou mais fotos (mantenha Ctrl ou Shift para escolher várias de uma vez)
                        </span>
                    </label>
                    <input data-input="imageSlideProduct" id="input-slide-images" type="file" name="slideImages"
                        accept="image/*" multiple class="peer sr-only" />

                    <!-- Galeria Interativa com Reordenação -->
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs md:text-sm font-semibold text-gray-600 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                                </svg>
                                Ordem de exibição dos slides (use as setas ou arraste para mudar a ordem):
                            </span>
                            <span data-info="slideImages" class="font-sans text-xs font-semibold text-green-600 truncate hidden"></span>
                        </div>

                        <!-- Lista visual de slides horizontal/scroll -->
                        <div data-slide-gallery
                            class="min-h-[140px] p-3 rounded-[10px] bg-gray-50 border border-gray-200 flex flex-row flex-wrap sm:flex-nowrap sm:overflow-x-auto gap-3 items-center scroll">
                            <p data-slide-empty class="text-sm text-gray-400 mx-auto text-center py-4">
                                Nenhum slide adicionado ainda. Adicione fotos acima para montar o slide do produto.
                            </p>
                        </div>
                    </div>
                </div>

                <button data-button="createProduct" type="button"
                    class="mt-2 w-full flex items-center justify-center gap-3 px-6 py-4 bg-green-600 rounded-[10px] shadow-sm hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all">
                    <span class="font-sans font-semibold text-lg md:text-xl text-white uppercase">Cadastrar
                        Produto</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Modal de Edição de Agendamento -->
    <aside data-modal="editSchedule"
        class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50 animate-fadeTop">
        <div
            class="relative w-[95%] max-w-[720px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="editSchedule"
                class="relative max-h-[95vh] overflow-y-auto scroll bg-white p-6 md:p-10 flex flex-col gap-6 md:gap-8">
                <button type="button" data-button="closeFormEditSchedule"
                    class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar Formulário" />
                </button>

                <!-- Overlay de Loading na Edição -->
                <div data-loading-edit
                    class="hidden absolute inset-0 z-50 bg-white/95 backdrop-blur-xs flex-col items-center justify-center gap-4 transition-all">
                    <div class="relative flex items-center justify-center">
                        <svg class="w-14 h-14 text-green-600 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="#bbf7d0" stroke-width="4"></circle>
                            <path class="opacity-90" fill="#16a34a" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                        <span class="font-sans font-bold text-lg text-gray-800">Salvando alterações...</span>
                        <span class="font-sans text-sm text-gray-500">Atualizando agendamento, enviando e-mail e preparando WhatsApp</span>
                    </div>
                </div>

                <div class="flex flex-col gap-1 pr-10">
                    <h3 class="font-sans font-bold text-xl md:text-2xl text-green-700 mt-1">
                        Editar Agendamento e Notificar Cliente
                    </h3>
                    <p class="font-sans text-xs md:text-sm text-gray-500">
                        Os dados antigos são carregados abaixo para você editar apenas o necessário. O cliente será notificado por e-mail e WhatsApp sobre as alterações.
                    </p>
                </div>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-edit-nome" class="font-sans font-semibold text-base md:text-lg text-gray-700">Nome
                        do Dono</label>
                    <input data-input="editScheduleName" id="input-edit-nome" type="text" name="nome"
                        placeholder="Nome completo" required minlength="3" maxlength="50"
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                </div>

                <div class="flex flex-col gap-[10px]">
                    <label for="select-edit-servico"
                        class="font-sans font-semibold text-base md:text-lg text-gray-700">Serviço Solicitado</label>
                    <div class="relative w-full">
                        <select id="select-edit-servico" name="servico" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none bg-white appearance-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all cursor-pointer">
                            <option value="" disabled selected>Selecione um serviço...</option>
                            <% if (locals.servicos && servicos.length > 0) { %>
                                <% servicos.forEach(servico => { %>
                                    <option value="<%= servico.id %>">
                                        <%= servico.nome %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <img src="/images/icons/arrow-down.svg" alt="Seta"
                            class="absolute right-4 top-1/2 -translate-y-1/2 w-6 h-6 pointer-events-none opacity-60" />
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-6">
                    <div class="flex flex-col gap-[10px] flex-1">
                        <label for="input-edit-telefone"
                            class="font-sans font-semibold text-base md:text-lg text-gray-700">Telefone / WhatsApp</label>
                        <input data-input="formatPhone" id="input-edit-telefone" type="tel" name="telefone"
                            placeholder="(00) 00000-0000" required minlength="14" maxlength="15"
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>

                    <div class="flex flex-col gap-[10px] flex-1">
                        <label for="input-edit-nome-pet"
                            class="font-sans font-semibold text-base md:text-lg text-gray-700">Nome do Pet</label>
                        <input data-input="editSchedulePetName" id="input-edit-nome-pet" type="text" name="nomePet"
                            placeholder="Nome do pet" required minlength="2" maxlength="40"
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-lg font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                </div>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-edit-data" class="font-sans font-semibold text-base md:text-lg text-gray-700">Data
                        do Agendamento</label>
