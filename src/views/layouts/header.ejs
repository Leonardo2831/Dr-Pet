<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style/output.css" />
    <% if (locals.swiper) { %>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <% } %>
    <% if (locals.quill) { %>
        <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css" />
    <% } %>
    <link rel="shortcut icon" href="/images/logo.png" type="image/x-icon" />
    <title><%= locals.tituloDaPagina ? tituloDaPagina : 'Dr. Pet' %></title>
</head>
<body class="antialiased">
    <div class="bg-green-600 sticky top-0 z-50">
        <header class="header container relative">
            <div class="container flex items-center justify-between mx-auto">
                <a href="/" class="flex items-center gap-[15px] md:gap-5 lg:gap-[25px] xl:gap-10">
                    <img src="/images/logo.png" alt="Logo Dr. Pet"
                        class="w-[45px] md:w-[50px] lg:w-[58px] xl:w-[68px] h-auto object-contain transition-all duration-300" />
                    <span
                        class="text-[26px] md:text-[28px] lg:text-[32px] font-semibold text-gray-50 tracking-wide transition-all duration-300 whitespace-nowrap">
                        Dr. Pet
                    </span>
                </a>

                <div id="nav-menu" data-menu="header"
                    class="hidden animate-fadeTop absolute top-[100%] left-0 w-full bg-green-600 shadow-2xl md:shadow-none flex-col items-center gap-[30px] py-10 opacity-100 visible translate-y-0 pointer-events-auto transition-all duration-300 ease-out z-40 md:flex md:static md:w-auto md:bg-transparent md:flex-row md:py-0 md:gap-5 lg:gap-10 xl:gap-20">

                    <nav class="flex flex-col md:flex-row items-center gap-[25px] md:gap-[15px] lg:gap-5 xl:gap-10">
                        <a href="/#servicos" class="nav-link whitespace-nowrap">Serviços</a>
                        <a href="/#sobre" class="nav-link whitespace-nowrap">Sobre nós</a>
                        <a href="/loja" class="nav-link whitespace-nowrap">Pet shop</a>
                        <a href="/agenda" data-login class="nav-link whitespace-nowrap">Agendamento</a>
                        <a href="/#contato" class="nav-link whitespace-nowrap">Contato</a>
                    </nav>

                   <button data-menuUser="false"
                        class="outline-none focus:ring-4 focus:ring-green-400 rounded-full border-[3px] border-green-50 p-3 md:p-2 lg:p-2 xl:p-3 hover:bg-green-700 transition-all duration-300 shadow-sm flex items-center justify-center">
                        <img src="/images/icons/user.svg" alt="Ícone de Usuário"
                            class="w-6 md:w-5 lg:w-6 xl:w-[30px] h-auto transition-all duration-300" />
                    </button>

                    <aside data-modal="menuUser"
                        class="overflow-hidden md:mt-7 lg:mt-9 hidden absolute top-full mx-auto w-fit md:left-auto md:right-0 md:mx-0 md:w-auto flex-col bg-gray-50 rounded-b-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] z-50 animate-fadeTop">
                        

                        <% if (locals.user) { %>
                            <!-- logado -->
                            <div class="flex flex-col w-[320px] sm:w-[480px] md:w-[730px] max-w-[90vw] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] rounded-b-[10px] overflow-hidden">
                                <div class="flex items-center w-full gap-[30px] p-[30px] bg-gray-100">
                                    <img src="<%= (locals.user && locals.user.avatar) ? locals.user.avatar : '/images/icons/options/user-default.svg' %>" alt="User Avatar" class="w-[60px] h-[60px] lg:w-20 lg:h-20 object-cover rounded-full" />
                                    <span class="font-semibold text-2xl text-gray-800 lg:text-3xl truncate">
                                        <%= locals.user.nome || "Minha Conta" %>
                                    </span>
                                </div>

                                <a href="/option-user" class="flex items-center w-full gap-[20px] p-[30px] bg-gray-50 hover:bg-gray-200 transition-colors duration-200 cursor-pointer border-b border-gray-200">
                                    <img src="/images/icons/menu-user/settings.svg" alt="Opções" class="w-10 h-10 lg:w-12 lg:h-12" />
                                    <span class="font-medium text-xl text-gray-800 lg:text-2xl">
                                        Opções
                                    </span>
                                </a>

                                <% if (locals.user.tipoUsuario && locals.user.tipoUsuario !== 'comum') { %>
                                    <a href="/administrador" class="flex items-center w-full gap-[20px] p-[30px] bg-gray-50 hover:bg-gray-200 transition-colors duration-200 cursor-pointer border-b border-gray-200">
                                        <img src="/images/icons/menu-user/admin-panel-settings.svg" alt="Painel de administração" class="w-10 h-10 lg:w-12 lg:h-12" />
                                        <span class="font-medium text-xl text-gray-800 lg:text-2xl">
                                            Painel de administrador
                                        </span>
                                    </a>
                                <% } %>

                                <a href="/logout" class="flex items-center w-full gap-[20px] p-[30px] bg-gray-50 hover:bg-gray-200 transition-colors duration-200 cursor-pointer">
                                    <img src="/images/icons/menu-user/logout.svg" alt="Sair" class="w-10 h-10 lg:w-12 lg:h-12" />
                                    <span class="font-medium text-xl text-gray-800 lg:text-2xl">
                                        Sair
                                    </span>
                                </a>
                            </div>

                        <% } else { %>
                            
                            <!-- nao logado -->
                            <a href="/cadastrar" 
                                class="flex items-center justify-center gap-[10px] py-6 px-9 w-full text-blue-link font-medium text-[22px] leading-[27px] hover:bg-gray-100 transition-colors duration-200 whitespace-nowrap">
                                Criar uma conta
                            </a>
                            <a href="/login"
                                class="flex items-center justify-center gap-[10px] py-6 px-9 w-full text-gray-950 font-medium text-[22px] leading-[27px] hover:bg-gray-100 transition-colors duration-200 whitespace-nowrap border-t border-gray-100">
                                Entrar
                            </a>

                        <% } %>
                    </aside>
                </div>

                <button data-button="menuUserMobile"
                    class="md:hidden flex flex-col gap-[6px] p-[10px] items-center justify-center outline-none focus:ring-2 focus:ring-green-400 rounded-md">
                    <div class="w-[30px] h-[3px] bg-white rounded-full"></div>
                    <div class="w-[30px] h-[3px] bg-white rounded-full"></div>
                    <div class="w-[30px] h-[3px] bg-white rounded-full"></div>
                </button>
            </div>
        </header>
    </div>


