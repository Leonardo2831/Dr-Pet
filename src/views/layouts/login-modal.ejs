<!-- Modal de checar login (só é renderizado para visitantes sem sessão ativa). Aberto pelo CheckLogin.js em qualquer elemento com o atributo data-login -->
<% if (!locals.user) { %>
    <aside data-modal="loginRequired" class="hidden fixed inset-0 z-[100] items-center justify-center p-4">

        <div data-login-overlay class="absolute inset-0 bg-black/60 opacity-0"></div>

        <div data-login-content class="relative w-full max-w-[460px] bg-gray-50 rounded-2xl shadow-2xl overflow-hidden opacity-0">
            <header class="bg-green-600 px-5 py-5 xs:px-8 xs:py-7 flex items-center justify-between">
                <figure class="flex items-center gap-4">
                    <img src="/images/logo.png" alt="Logo Dr. Pet" class="w-[34px] xs:w-[42px] h-auto object-contain" />
                    <span class="text-lg xs:text-xl md:text-2xl font-semibold text-gray-50">Dr. Pet</span>
                </figure>
                <button type="button" data-login-close aria-label="Fechar" class="text-gray-50 hover:text-green-200 transition-colors duration-200 p-1 outline-none focus:ring-2 focus:ring-green-200 rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </header>

            <div class="px-5 py-5 xs:px-8 xs:py-8 flex flex-col items-center gap-4 xs:gap-6 text-center">

                <figure class="w-[56px] h-[56px] xs:w-[72px] xs:h-[72px] bg-green-500 rounded-full flex items-center justify-center shadow-sm">
                    <img src="/images/icons/user.svg" alt="Criar Conta">
                </figure>

                <div class="flex flex-col gap-2">
                    <h3 class="text-xl xs:text-2xl md:text-[26px] font-bold text-gray-800 leading-tight">
                        Acesse sua conta
                    </h3>
                    <p class="text-sm xs:text-base md:text-lg font-medium text-gray-500 leading-relaxed max-w-[360px]">
                        Para agendar serviços para o seu pet, é necessário estar logado na sua conta.
                    </p>
                </div>

                <a href="/cadastrar"
                    class="min-w-0 w-full flex items-center justify-center gap-2 xs:gap-3 px-3 xs:px-6 py-3 xs:py-4 bg-green-500 hover:bg-green-400 text-xs xs:text-base md:text-xl font-bold text-gray-50 uppercase rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                    <img src="/images/icons/user.svg" alt="Criar Conta" class="w-5 h-5 shrink-0">
                    <span class="truncate">Criar minha conta</span>
                </a>

                <div class="flex items-center gap-4 w-full">
                    <div class="flex-1 h-px bg-gray-200"></div>
                    <span class="text-sm font-medium text-gray-400 uppercase tracking-wide">ou</span>
                    <div class="flex-1 h-px bg-gray-200"></div>
                </div>

                <a href="/login"
                    class="min-w-0 w-full flex items-center justify-center gap-3 px-3 xs:px-6 py-3 xs:py-[14px] border-2 border-green-500 text-green-600 hover:bg-green-50 text-xs xs:text-base md:text-lg font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                    <span class="truncate">Já tenho uma conta</span>
                </a>
            </div>
        </div>
    </aside>
<% } %>
