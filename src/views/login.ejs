<%- include('layouts/header', { tituloDaPagina: 'Dr.Pet | Login' }) %>

    <main class="flex flex-col lg:flex-row">
        <section
            class="order-1 lg:order-2 flex-1 flex items-center justify-center bg-gray-50 px-5 py-10 xs:px-6 xs:py-11 sm:px-8 sm:py-12 lg:px-[60px] lg:py-[60px]">
            <form data-form="login" class="w-full max-w-[760px] flex flex-col gap-8 lg:gap-[30px]">
                <h1 class="text-green-600 font-semibold text-[34px] leading-[42px] xs:text-[38px] xs:leading-[46px] sm:text-[42px] sm:leading-[50px] lg:text-[52px] lg:leading-[64px]"
                    id="form-login">
                    Login
                </h1>

                <div class="flex flex-col gap-[30px]">
                    <div class="flex flex-col gap-[15px]">
                        <label for="email"
                            class="font-medium text-[19px] leading-[24px] tracking-[0.3px] text-green-700 xs:text-[20px] xs:leading-[25px] sm:text-[22px] sm:leading-[28px] lg:text-[26px] lg:leading-[32px]">E-mail</label>
                        <div
                            class="relative flex items-center border-b-2 border-green-700 h-[62px] px-[15px] py-4 sm:h-[66px] lg:h-[70px] lg:py-5">
                            <input data-input="emailLogin" type="email" id="email" name="email" autocomplete="email"
                                class="w-full bg-transparent text-[18px] leading-tight text-green-700 outline-none xs:text-[19px] sm:text-[20px] lg:text-[24px]"
                                required minlength="5" maxlength="80" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-[20px]">
                        <div class="flex flex-col gap-[15px]">
                            <label for="current-password"
                                class="font-medium text-[19px] leading-[24px] tracking-[0.3px] text-green-700 xs:text-[20px] xs:leading-[25px] sm:text-[22px] sm:leading-[28px] lg:text-[26px] lg:leading-[32px]">Senha</label>
                            <div
                                class="relative flex items-center border-b-2 border-green-700 h-[62px] px-[15px] py-4 sm:h-[66px] lg:h-[70px] lg:py-[20px]">
                                <input data-input="passwordLogin" type="password" id="current-password"
                                    name="current-password" autocomplete="current-password"
                                    class="w-full bg-transparent text-[18px] leading-tight text-green-700 outline-none pr-11 xs:text-[19px] sm:text-[20px] lg:text-2xl"
                                    required minlength="8" maxlength="60" />
                                <button data-toggle-password="current-password" type="button" id="toggle-password"
                                    class="absolute right-[15px] flex items-center justify-center w-[30px] h-[30px] rounded-[6px] outline-none focus:ring-2 focus:ring-green-300">
                                    <img src="/images/icons/forms/visibility_off.svg" alt="Mostrar senha"
                                        class="w-[30px] h-[30px]" />
                                </button>
                            </div>
                        </div>
                        <a href="#"
                            class="font-semibold text-[18px] leading-[22px] text-green-700 underline w-fit hover:text-green-600 transition-colors xs:text-[19px] xs:leading-[23px] sm:text-[20px] sm:leading-[24px] lg:text-[22px] lg:leading-[27px]">
                            Esqueceu a senha?
                        </a>
                    </div>
                </div>

                <button type="button"
                    class="w-full h-[64px] rounded-[10px] bg-gray-300 px-4 xs:px-5 sm:px-6 py-3 flex items-center justify-center gap-3 xs:gap-5 sm:gap-8 lg:gap-[50px] hover:bg-gray-200 transition-colors outline-none focus:ring-4 focus:ring-gray-300">
                    <span
                        class="font-semibold text-lg leading-[22px] text-gray-800 xs:text-2xl sm:text-[26px] lg:text-[26px] lg:leading-[32px]">Login
                        com Google</span>
                    <img src="/images/icons/forms/google-icon.svg" alt="Ícone Google"
                        class="w-8 h-8 xs:w-9 xs:h-9 sm:w-9 sm:h-9 lg:w-10 lg:h-10" />
                </button>

                <div class="w-full flex flex-wrap justify-center gap-5">
                    <button type="submit"
                        class="basis-full w-[280px] xs:w-[290px] sm:w-[300px] h-[69px] rounded-[10px] bg-green-600 px-8 py-4 flex items-center justify-center hover:bg-green-500 transition-colors outline-none focus:ring-4 focus:ring-green-600 mx-auto">
                        <span
                            class="font-semibold text-[22px] leading-[28px] text-gray-50 xs:text-[24px] xs:leading-[30px] sm:text-[26px] sm:leading-[33px] lg:text-[30px] lg:leading-[37px]">Continuar</span>
                    </button>
                    <a href="/cadastrar"
                        class="btn-create-account basis-full w-[280px] xs:w-[290px] sm:w-[300px] h-[69px] rounded-[10px] px-8 py-4 flex items-center justify-center outline-none focus:ring-2 focus:ring-green-300 mx-auto">
                        <span
                            class="font-semibold text-[22px] leading-[28px] text-green-700 xs:text-[24px] xs:leading-[30px] sm:text-[26px] sm:leading-[33px] lg:text-[30px] lg:leading-[37px]">Criar
                            Conta</span>
                    </a>
                </div>
            </form>
            <div id="modal-info"></div>
        </section>

        <figure class="order-2 lg:order-1 flex-1 w-full h-full flex">
            <img src="/images/forms-images/login.jpg" alt="Faça Login em nosso site"
                class="w-full h-full object-contain lg:object-cover" />
        </figure>
    </main>

    <aside data-modal-info-menu="user" data-modal-info="login"
        class="hidden z-30 animate-fadeItem opacity-0 fixed bottom-8 left-1/2 -translate-x-1/2 p-4 text-center font-semibold text-lg">
    </aside>

    <!-- Modal de checar login -->
    <aside data-modal="loginRequired" class="hidden fixed inset-0 z-50 items-center justify-center p-4">

        <div data-login-overlay class="absolute inset-0 bg-black/60 opacity-0"></div>

        <div data-login-content
            class="relative w-full max-w-[460px] bg-gray-50 rounded-2xl shadow-2xl overflow-hidden opacity-0">
            <header class="bg-green-600 px-5 py-5 xs:px-8 xs:py-7 flex items-center justify-between">
                <figure class="flex items-center gap-4">
                    <img src="/images/logo.png" alt="Logo Dr. Pet"
                        class="w-[34px] xs:w-[42px] h-auto object-contain" />
                    <span class="text-lg xs:text-xl md:text-2xl font-semibold text-gray-50">Dr. Pet</span>
                </figure>
                <button data-login-close
                    class="text-gray-50 hover:text-green-200 transition-colors duration-200 p-1 outline-none focus:ring-2 focus:ring-green-200 rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </header>

            <div class="px-5 py-5 xs:px-8 xs:py-8 flex flex-col items-center gap-4 xs:gap-6 text-center">

                <figure
                    class="w-[56px] h-[56px] xs:w-[72px] xs:h-[72px] bg-green-500 rounded-full flex items-center justify-center shadow-sm">
                    <img src="/images/icons/user.svg" alt="Criar Conta">
                </figure>

                <div class="flex flex-col gap-2">
                    <h3 class="text-xl xs:text-2xl md:text-[26px] font-bold text-gray-800 leading-tight">
                        Acesse sua conta
                    </h3>
                    <p class="text-sm xs:text-base md:text-lg font-medium text-gray-500 leading-relaxed max-w-[360px]">
                        Para agendar serviços para o seu pet, é necessário estar logado na sua conta.
                    </p>
                </div>

                <a href="/cadastrar"
                    class="min-w-0 w-full flex items-center justify-center gap-2 xs:gap-3 px-3 xs:px-6 py-3 xs:py-4 bg-green-500 hover:bg-green-400 text-xs xs:text-base md:text-xl font-bold text-gray-50 uppercase rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                    <img src="/images/icons/user.svg" alt="Criar Conta" class="w-5 h-5 shrink-0">
                    <span class="truncate">Criar minha conta</span>
                </a>

                <div class="flex items-center gap-4 w-full">
                    <div class="flex-1 h-px bg-gray-200"></div>
                    <span class="text-sm font-medium text-gray-400 uppercase tracking-wide">ou</span>
                    <div class="flex-1 h-px bg-gray-200"></div>
                </div>

                <a href="/login"
                    class="min-w-0 w-full flex items-center justify-center gap-3 px-3 xs:px-6 py-3 xs:py-[14px] border-2 border-green-500 text-green-600 hover:bg-green-50 text-xs xs:text-base md:text-lg font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                    <span class="truncate">Já tenho uma conta</span>
                </a>
            </div>
        </div>
    </aside>

<%- include('layouts/footer', { scripts: [
    { src: '/javascript/menu-user/script-menu-user.js', module: true },
    { src: '/javascript/forms/login-account/script-login.js', module: true }
] }) %>


