<%- include('layouts/header') %>

    <div class="bg-gray-50 min-h-screen">
        <main class="main container w-full flex justify-center pb-20 md:pb-[120px]">
            <section class="w-full flex flex-col gap-10 lg:gap-20">
                <h1 class="text-4xl md:text-[52px] leading-snug md:leading-[64px] font-bold text-green-700 text-center">
                    Agendamento
                </h1>

                <div class="w-full flex flex-col xl:flex-row justify-between items-start gap-10">

                    <div class="w-full flex-[5] flex flex-col items-center gap-10">

                        <div data-button="selectService"
                            class="relative w-full bg-white shadow-md rounded-[10px] flex flex-row justify-between items-center px-5 py-5 md:px-[50px] md:py-[30px] transition-all hover:shadow-lg focus-within:ring-2 focus-within:ring-green-400 cursor-pointer">
                            <div class="flex flex-row items-center gap-5 md:gap-[30px]">
                                <img data-imgInfo="agenda-service-image" src="/images/services/banho-tosa.png"
                                    alt="Cachorro no serviço de Banho e Tosa"
                                    class="w-20 h-[56px] md:w-[106px] md:h-[74px] object-cover rounded-[5px]" />
                                <div class="flex flex-col justify-center gap-1">
                                    <span
                                        class="text-sm md:text-base lg:text-[18px] leading-tight font-normal text-gray-900">
                                        Serviço selecionado
                                    </span>
                                    <h2 data-textInfo="agenda-service"
                                        class="text-gray-900 text-2xl font-semibold md:text-3xl">Banho e Tosa</h2>
                                </div>
                            </div>

                            <img src="/images/icons/arrow-down.svg" alt="Ícone seta"
                                class="w-10 h-10 md:w-[50px] md:h-[50px] lg:w-[60px] lg:h-[60px] pointer-events-none" />

                            <aside data-modal="serviceSelected"
                                class="left-0 hidden absolute top-full w-full flex-col bg-gray-50 rounded-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] z-50 animate-fadeTop">
                                <p data-filter-agenda="banho-tosa"
                                    class="activeOption flex items-center justify-center gap-[10px] py-6 px-9 w-full text-gray-950 font-medium text-[22px] leading-[27px] hover:bg-gray-100 transition-colors duration-200 whitespace-nowrap">
                                    Banho e Tosa
                                </p>
                                <p data-filter-agenda="vacinacao"
                                    class="flex items-center justify-center gap-[10px] py-6 px-9 w-full text-gray-950 font-medium text-[22px] leading-[27px] hover:bg-gray-100 transition-colors duration-200 whitespace-nowrap">
                                    Vacinação
                                </p>
                                <p data-filter-agenda="cirurgia"
                                    class="flex items-center justify-center gap-[10px] py-6 px-9 w-full text-gray-950 font-medium text-[22px] leading-[27px] hover:bg-gray-100 transition-colors duration-200 whitespace-nowrap">
                                    Cirurgia
                                </p>
                            </aside>
                        </div>

                        <div class="w-full bg-white shadow-md rounded-[10px] flex flex-col gap-8 p-5 md:pt-[30px] md:px-[30px] md:pb-10">

                            <div class="w-full flex flex-row justify-between md:justify-center items-center gap-2 md:gap-[100px] h-auto md:h-[70px]">
                                <button data-button="prev-month" type="button" aria-label="Mês anterior"
                                    class="hover:bg-gray-100 p-2 rounded-full transition-colors focus:ring-2 focus:ring-green-400 outline-none group">
                                    <img src="/images/icons/calender/arrow-gray.svg" alt="Seta Mês Anterior"
                                        class="w-10 h-10 md:w-[60px] md:h-[60px] opacity-60 group-hover:opacity-100 transition-opacity" />
                                </button>
                                <div class="flex justify-center items-center p-2 w-auto md:min-w-[225px]">
                                    <h2 class="flex flex-wrap justify-center gap-3 md:gap-4 text-2xl md:text-[40px] leading-tight md:leading-[50px] font-semibold text-gray-800">
                                        <span data-calender-title="month">Abril</span> 
                                        <span data-calender-title="year">2025</span>
                                    </h2>
                                </div>
                                <button data-button="next-month" type="button" aria-label="Próximo mês"
                                    class="hover:bg-gray-100 p-2 rounded-full transition-colors focus:ring-2 focus:ring-green-400 outline-none group">
                                    <img src="/images/icons/calender/arrow-gray.svg" alt="Seta Próximo Mês"
                                        class="w-10 h-10 md:w-[60px] md:h-[60px] rotate-180 opacity-60 group-hover:opacity-100 transition-opacity" />
                                </button>
                            </div>

                            <div class="w-full flex flex-col p-2 md:p-4">
                                <div data-container="calender-days" class="grid grid-cols-7 gap-x-1 gap-y-3 md:gap-x-4 md:gap-y-6 lg:gap-x-[42px] lg:gap-y-[30px] place-items-center w-full">
                                </div>
                            </div>

                            <div class="w-full flex flex-col gap-5 animate-fadeTop">
                                <h3 class="text-[22px] md:text-[26px] leading-[28px] md:leading-[32px] font-semibold text-gray-900">
                                    Horários Disponíveis:
                                </h3>

                                <div class="w-full flex flex-col gap-5 md:gap-8">

                                    <div class="flex flex-col gap-3">
                                        <h4 class="text-[18px] md:text-[22px] font-medium text-green-400">Manhã</h4>
                                        <div data-content="hours-morning" class="flex flex-row flex-wrap items-center gap-3 md:gap-4"></div>
                                    </div>

                                    <div class="flex flex-col gap-3">
                                        <h4 class="text-[18px] md:text-[22px] font-medium text-green-400">Tarde</h4>
                                        <div data-content="hours-afternoon" class="flex flex-row flex-wrap items-center gap-3 md:gap-4"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <aside
                        class="w-full flex-[3.5] flex flex-col shadow-xl bg-white rounded-b-[10px] mt-5 xl:mt-0 relative"
                        aria-label="Resumo do agendamento">
                        <img data-imgInfo-service="completInfo" src="/images/services/banho-tosa.png"
                            alt="Serviço de Banho e tosa" class="w-full h-auto object-cover rounded-t-[10px]" />

                        <div
                            class="w-full h-fit -mt-1 bg-white border-t-4 border-green-400 rounded-b-[10px] p-5 md:p-[30px] flex flex-col gap-5 md:gap-10 z-10">

                            <div class="flex flex-col gap-5 w-full">
                                <span
                                    class="text-[20px] md:text-[26px] leading-snug font-medium text-gray-800 tracking-wide">
                                    Serviço solicitado:
                                    <strong data-textInfo-service="completInfo"
                                        class="text-[24px] md:text-[30px] leading-snug font-semibold text-green-500">
                                        Banho e tosa
                                    </strong>
                                </span>

                                <div class="flex flex-col gap-4 md:gap-5">
                                    <div class="flex flex-row items-center gap-3 md:gap-4">
                                        <img src="/images/icons/calender/hour.svg" alt="Horário">
                                        <span class="text-xl md:text-[26px] font-medium text-gray-800">
                                            Tempo: 
                                            <strong data-time-service="completInfo" class="font-semibold text-gray-800">
                                                1h 30min
                                            </strong>
                                        </span>
                                    </div>

                                    <div class="flex flex-row items-center gap-3 md:gap-4">
                                        <img src="/images/icons/calender/price.svg" alt="Preço">
                                        <span class="text-xl md:text-[26px] font-medium text-gray-800">
                                            Preço:
                                            <strong data-price-service="completInfo" class="font-semibold text-gray-800"></strong>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <p class="min-h-[85px] flex flex-col gap-2 text-2xl md:text-[30px] leading-tight font-semibold text-gray-800">
                                <span data-schedule-date="agenda"></span>
                                <span data-schedule-time="agenda"></span>
                            </p>

                            <div>
                                <button data-button="submitInfosSchedule" type="button"
                                class="w-full flex flex-row justify-center items-center gap-4 md:gap-5 py-4 md:py-6 px-5 md:px-9 bg-green-500 rounded-[10px] shadow-md hover:bg-green-600 transition-colors focus:ring-4 focus:ring-green-400 focus:outline-none focus:ring-offset-2">
                                    <span
                                        class="text-[22px] md:text-[30px] font-semibold text-gray-50 uppercase text-center">Avançar</span>
                                    <img src="/images/icons/calendar_clock.svg" alt="Confirme"
                                        class="w-8 h-8 md:w-10 md:h-10">
                                </button>
                            </div>
                        </div>
                    </aside>
                </div>
            </section>
        </main>
    </div>

    <aside data-modal-info-menu="user" data-modal-info="agenda"
        class="hidden z-30 animate-fadeItem opacity-0 fixed bottom-8 left-1/2 -translate-x-1/2 p-4 text-center font-semibold text-lg">
    </aside>

        <!-- Modal de checar login -->
    <aside data-modal="loginRequired" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
            
        <div data-login-overlay class="absolute inset-0 bg-black/60 opacity-0"></div>

        <div data-login-content class="relative w-full max-w-[460px] bg-gray-50 rounded-2xl shadow-2xl overflow-hidden opacity-0">
                <header class="bg-green-600 px-5 py-5 xs:px-8 xs:py-7 flex items-center justify-between">
                    <figure class="flex items-center gap-4">
                        <img src="/images/logo.png" alt="Logo Dr. Pet" class="w-[34px] xs:w-[42px] h-auto object-contain" />
                        <span class="text-lg xs:text-xl md:text-2xl font-semibold text-gray-50">Dr. Pet</span>
                    </figure>
                    <button data-login-close class="text-gray-50 hover:text-green-200 transition-colors duration-200 p-1 outline-none focus:ring-2 focus:ring-green-200 rounded-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </header>

                <div class="px-5 py-5 xs:px-8 xs:py-8 flex flex-col items-center gap-4 xs:gap-6 text-center">
                    
                    <figure class="w-[56px] h-[56px] xs:w-[72px] xs:h-[72px] bg-green-500 rounded-full flex items-center justify-center shadow-sm">
                        <img src="/images/icons/user.svg" alt="Criar Conta">
                    </figure>

                    <div class="flex flex-col gap-2">
                        <h3 class="text-xl xs:text-2xl md:text-[26px] font-bold text-gray-800 leading-tight">
                            Acesse sua conta
                        </h3>
                        <p class="text-sm xs:text-base md:text-lg font-medium text-gray-500 leading-relaxed max-w-[360px]">
                            Para agendar serviços para o seu pet, é necessário estar logado na sua conta.
                        </p>
                    </div>

                    <a href="cadastrar.html"
                        class="min-w-0 w-full flex items-center justify-center gap-2 xs:gap-3 px-3 xs:px-6 py-3 xs:py-4 bg-green-500 hover:bg-green-400 text-xs xs:text-base md:text-xl font-bold text-gray-50 uppercase rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                        <img src="/images/icons/user.svg" alt="Criar Conta" class="w-5 h-5 shrink-0">
                        <span class="truncate">Criar minha conta</span>
                    </a>

                    <div class="flex items-center gap-4 w-full">
                        <div class="flex-1 h-px bg-gray-200"></div>
                        <span class="text-sm font-medium text-gray-400 uppercase tracking-wide">ou</span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>

                    <a href="login.html"
                        class="min-w-0 w-full flex items-center justify-center gap-3 px-3 xs:px-6 py-3 xs:py-[14px] border-2 border-green-500 text-green-600 hover:bg-green-50 text-xs xs:text-base md:text-lg font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                        <span class="truncate">Já tenho uma conta</span>
                    </a>
                </div>
        </div>
    </aside>

<%- include('layouts/footer', { scripts: [
    { src: 'https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js', module: false },
    { src: '/javascript/agendamento/script-agendamento.js', module: true },
    { src: '/javascript/menu-user/script-menu-user.js', module: true }    
] }) %>