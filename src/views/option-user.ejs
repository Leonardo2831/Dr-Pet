<%- include('layouts/header', { tituloDaPagina: 'Dr.Pet | Opções do Usuário' }) %>

<!-- usar rotas para mostrar cada aba, como endereço... -->

    <div class="bg-gray-50">
        <main class="container min-h-[calc(100vh_-_570px)] w-full p-6 md:p-10 lg:p-20 flex flex-col justify-center">
            <section
                class="animate-fadeTop w-full shadow-md rounded-2xl overflow-hidden bg-gray-100"
                id="menu-inicial"
            >
                <div
                    class="flex items-center gap-4 sm:gap-6 p-4 sm:p-6 lg:p-8 bg-gray-200"
                >
                    <figure class="relative flex-shrink-0">
                        <img
                            src="/images/icons/options/user-default.svg"
                            alt="Foto do Usuário"
                            class="w-12 h-12 xs:w-16 xs:h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24 object-cover rounded-full"
                        />
                        <label
                            for="image-user"
                            class="cursor-pointer absolute bottom-0 right-0 outline-none focus:ring-2 focus:ring-green-400 rounded-full hover:scale-110 transition-transform"
                        >
                            <img
                                src="/images/icons/options/edit-circle.svg"
                                alt="Editar Foto"
                                class="w-4 h-4 sm:w-7 sm:h-7 lg:w-8 lg:h-8 bg-gray-200 rounded-full"
                            />
                            <input type="file" data-input="avatarUser" id="image-user" name="image-user" class="hidden" hidden>
                        </label>
                    </figure>
                    <div
                        class="flex items-center gap-3 sm:gap-4 lg:gap-6 flex-wrap w-full"
                    >
                        <span data-info="nameUser"
                            class="text-xl sm:text-2xl lg:text-3xl font-semibold text-gray-800 break-words line-clamp-2"
                            ></span
                        >
                        <button data-button="editarNome"
                            class="p-3 outline-none focus:ring-2 focus:ring-green-400 rounded-full flex-shrink-0 hover:scale-110 transition-transform"
                        >
                            <img
                                src="/images/icons/options/edit.svg"
                                alt="Editar Nome"
                                class="w-5 h-5 sm:w-6 sm:h-6 lg:w-8 lg:h-8"
                            />
                        </button>
                    </div>
                </div>

                <button
                    data-target="dados-pessoais"
                    class="w-full flex items-center gap-4 sm:gap-6 p-4 sm:p-6 lg:p-8 hover:bg-gray-200 transition-colors focus:bg-gray-200 outline-none border-b border-gray-200/50"
                >
                    <div
                        class="w-12 sm:w-16 lg:w-20 flex justify-center items-center flex-shrink-0"
                    >
                        <img
                            src="/images/icons/options/card-people.svg"
                            alt="Ícone Dados Pessoais"
                            class="w-8 h-8 sm:w-10 sm:h-10 lg:w-12 lg:h-12 object-contain"
                        />
                    </div>
                    <span
                        class="text-lg sm:text-xl lg:text-2xl font-semibold text-gray-700"
                        >Dados pessoais</span
                    >
                </button>

                <button
                    data-target="Endereco"
                    class="w-full  flex items-center gap-4 sm:gap-6 p-4 sm:p-6 lg:p-8 hover:bg-gray-200 transition-colors focus:bg-gray-200 outline-none border-b border-gray-200/50"
                >
                    <div
                        class="w-12 sm:w-16 lg:w-20 flex justify-center items-center flex-shrink-0"
                    >
                        <img
                            src="/images/icons/options/location.svg"
                            alt="Ícone Endereço"
                            class="w-8 h-8 sm:w-10 sm:h-10 lg:w-12 lg:h-12 object-contain"
                        />
                    </div>
                    <span
                        class="text-lg sm:text-xl lg:text-2xl font-semibold text-gray-700"
                        >Endereço</span
                    >
                </button>

                <button
                    data-target="dados-pet"
                    class="w-full  flex items-center gap-4 sm:gap-6 p-4 sm:p-6 lg:p-8 hover:bg-gray-200 transition-colors focus:bg-gray-200 outline-none"
                >
                    <div
                        class="w-12 sm:w-16 lg:w-20 flex justify-center items-center flex-shrink-0"
                    >
                        <img
                            src="/images/icons/options/pets.png"
                            alt="Ícone Pets"
                            class="w-8 h-8 sm:w-10 sm:h-10 lg:w-12 lg:h-12 object-cover rounded-full"
                        />
                    </div>
                    <span
                        class="text-lg sm:text-xl lg:text-2xl font-semibold text-gray-700"
                        >Pets</span
                    >
                </button>
            </section>

            <!-- menu dados pessoais -->
            <section
                class="animate-fadeLeft hidden w-full rounded-2xl shadow-sm"
                id="dados-pessoais"
            >
                <nav
                    class="mb-10 flex items-center gap-2 sm:gap-3 text-2xl sm:text-3xl lg:text-[40px] font-bold text-green-600 leading-tight lg:leading-[50px]"
                >
                    <span
                        data-target="menu-inicial"
                        class="hover:text-green-700 hover:underline transition-colors focus:outline-none focus:ring-2 focus:ring-green-400 rounded-md cursor-pointer"
                        >Menu</span
                    >
                    <span
                        class="select-none text-[0.8em]"
                        aria-hidden="true"
                        >&gt;</span
                    >
                    <span aria-current="page">Dados Pessoais</span>
                </nav>

                <div
                    class="flex flex-col w-full shadow-sm rounded-[10px] bg-gray-100"
                >
                    <div
                        class="flex flex-row items-center justify-between gap-3 p-4 sm:p-6 lg:p-[30px] border-b border-gray-200/50"
                    >
                        <div
                            class="flex flex-row items-center gap-4 sm:gap-5"
                        >
                            <figure
                                class="w-12 sm:w-16 lg:w-[81px] flex justify-center items-center flex-shrink-0"
                            >
                                <img
                                    src="/images/icons/options/dados-pesssoais/email.svg"
                                    alt="Ícone Email"
                                    class="w-8 h-8 sm:w-10 sm:h-10 lg:w-[45px] lg:h-auto object-contain"
                                />
                            </figure>
                            <div
                                class="flex flex-col gap-1 sm:gap-2 lg:gap-[10px]"
                            >
                                <span
                                    class="text-xl sm:text-2xl lg:text-[32px] font-semibold text-gray-800 leading-tight lg:leading-[40px]"
                                >Email</span
                                >
                                <span data-info="email"
                                    class="text-base sm:text-lg lg:text-[22px] font-normal text-gray-700 leading-snug lg:leading-[27px] break-all"
                                ></span>
                            </div>
                        </div>
                        <a
                            href="#"
                            class="inline-block text-lg sm:text-xl md:text-2xl font-semibold text-blue-link underline hover:text-blue-hover transition-all duration-300 outline-none focus:ring-2 focus:ring-blue-link rounded-md p-2 mt-2 sm:mt-0"
                            data-button="openEditEmail"
                        >
                            Alterar Email
                        </a>
                    </div>

                    <div
                        class="flex flex-row items-center justify-between gap-3 p-4 sm:p-6 lg:p-[30px] border-b border-gray-200/50"
                    >
                        <div
                            class="flex flex-row items-center gap-4 sm:gap-5"
                        >
                            <figure
                                class="w-12 sm:w-16 lg:w-[81px] flex justify-center items-center flex-shrink-0"
                            >
                                <img
                                    src="/images/icons/options/dados-pesssoais/phone.svg"
                                    alt="Ícone Telefone"
                                    class="w-8 h-8 sm:w-10 sm:h-10 lg:w-[50px] lg:h-auto object-contain"
                                />
                            </figure>
                            <div
                                class="flex flex-col gap-1 sm:gap-2 lg:gap-[10px]"
                            >
                                <span
                                    class="text-xl sm:text-2xl lg:text-[32px] font-semibold text-gray-800 leading-tight lg:leading-[40px]"
                                >Telefone</span
                                >
                                <span data-info="telefone"
                                    class="text-base sm:text-lg lg:text-[22px] font-normal text-gray-700 leading-snug lg:leading-[27px]"
                                ></span>
                            </div>
                        </div>
                        <a
                            href="#"
                            class="inline-block text-lg sm:text-xl md:text-2xl font-semibold text-blue-link underline hover:text-blue-hover transition-all duration-300 outline-none focus:ring-2 focus:ring-blue-link rounded-md p-2 mt-2 sm:mt-0"
                            data-button="openEditTelefone"
                        >
                            Alterar telefone
                        </a>
                    </div>

                    <div
                        class="flex flex-row items-center justify-between p-4 sm:p-6 lg:p-[30px] flex-wrap gap-4"
                    >
                        <div
                            class="flex flex-row items-center gap-4 sm:gap-5"
                        >
                            <div
                                class="w-12 sm:w-16 lg:w-[81px] flex justify-center items-center flex-shrink-0"
                            >
                                <img
                                    src="/images/icons/options/dados-pesssoais/key.svg"
                                    alt="Ícone Senha"
                                    class="w-8 h-8 sm:w-10 sm:h-10 lg:w-[45px] lg:h-auto object-contain"
                                />
                            </div>
                            <div
                                class="flex flex-col gap-1 sm:gap-2 lg:gap-[10px]"
                            >
                                <span
                                    class="text-xl sm:text-2xl lg:text-[32px] font-semibold text-gray-800 leading-tight lg:leading-[40px]"
                                >Senha</span
                                >
                                <span data-info="senha"
                                    class="text-base sm:text-lg lg:text-[22px] font-normal text-gray-700 leading-snug lg:leading-[27px]"
                                ></span>
                            </div>
                        </div>
                        <a
                            href="#"
                            class="inline-block text-lg sm:text-xl md:text-2xl font-semibold text-blue-link underline hover:text-blue-hover transition-all duration-300 outline-none focus:ring-2 focus:ring-blue-link rounded-md p-2 mt-2 sm:mt-0"
                            data-button="openEditSenha"
                        >
                            Alterar senha
                        </a>
                    </div>
                </div>
            </section>

            <!-- menu endereços -->
            <section class="animate-fadeRight hidden w-full rounded-2xl shadow-sm" id="Endereco">
                <nav
                    class="mb-10 flex items-center gap-2 sm:gap-3 text-2xl sm:text-3xl lg:text-[40px] font-bold text-green-600 leading-tight lg:leading-[50px]"
                >
                    <span
                        data-target="menu-inicial"
                        class="hover:text-green-700 hover:underline transition-colors focus:outline-none focus:ring-2 focus:ring-green-400 rounded-md cursor-pointer"
                    >
                        Menu
                    </span>
                    <span
                        class="select-none text-[0.8em]"
                        aria-hidden="true"
                    >
                        &gt;
                    </span>
                    <span aria-current="page">Endereços</span>
                </nav>
                <div class="flex flex-col w-full shadow-sm rounded-[10px] bg-gray-100">
                    <div id="address-container" class="peer">
                        <!-- endereços aparecem aqui dinamicamente -->
                    </div>
                    <div class="flex flex-row items-center p-4 sm:p-6 lg:p-[30px] rounded-b-[10px] peer-has-[div]:border-t-[3px] peer-has-[div]:border-gray-400">
                        <a data-button="address" href="#"
                            class="inline-block text-lg sm:text-xl lg:text-2xl font-medium text-blue-link hover:text-blue-hover hover:scale-[1.02] active:scale-95 transition-all duration-300 outline-none focus:ring-2 focus:ring-blue-link rounded-md p-2"
                        >Adicionar endereço</a>
                    </div>
                </div>
            </section>

            <!-- menu pets -->
            <section
                class="animate-fadeDown hidden w-full rounded-2xl shadow-sm"
                id="dados-pet"
            >
                <nav
                    class="mb-10 flex items-center gap-2 sm:gap-3 text-2xl sm:text-3xl lg:text-[40px] font-bold text-green-600 leading-tight lg:leading-[50px]"
                >
                    <span
                        data-target="menu-inicial"
                        class="hover:text-green-700 hover:underline transition-colors focus:outline-none focus:ring-2 focus:ring-green-400 rounded-md cursor-pointer"
                    >
                        Menu
                    </span>
                    <span
                        class="select-none text-[0.8em]"
                        aria-hidden="true"
                    >
                        &gt;
                    </span>
                    <span aria-current="page">Pets</span>
                </nav>

                <div class="flex flex-col w-full shadow-sm rounded-[10px] bg-gray-100">
                    <div id="pet-container" class="peer">
                        <!-- pets aparecem aqui dinamicamente -->
                    </div>
                    <div class="flex flex-row items-center p-4 sm:p-6 lg:p-[30px] rounded-b-[10px] peer-has-[div]:border-t-[3px] peer-has-[div]:border-gray-400">
                        <a data-button="Pet" href="#"
                            class="inline-block text-lg sm:text-xl lg:text-2xl font-medium text-blue-link hover:text-blue-hover hover:scale-[1.02] active:scale-95 transition-all duration-300 outline-none focus:ring-2 focus:ring-blue-link rounded-md p-2">
                            Adicionar pet
                        </a>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- pop-up pets -->
    <aside
        data-popup="options-pet"
        class="hidden fixed z-[999] flex-col bg-gray-50 rounded-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] min-w-max overflow-hidden animate-fadeTop"
    >
        <button data-button="editPet"
            class="flex flex-row items-center justify-center gap-[30px] px-9 py-6 w-full bg-gray-100 hover:brightness-95 transition-all duration-200 outline-none focus:ring-2 focus:ring-green-400"
            aria-label="Editar pet"
        >
            <span
                class="text-[22px] leading-[27px] font-medium text-green-400 whitespace-nowrap"
            >
                Editar
            </span>
            <img
                src="/images/icons/options/edit.svg"
                alt="Ícone Editar"
                class="w-6 h-6 flex-shrink-0"
            />
        </button>
        <button data-button="deletePet"
            class="flex flex-row items-center justify-center gap-[30px] px-9 py-6 w-full bg-gray-100 hover:brightness-95 transition-all duration-200 outline-none focus:ring-2 focus:ring-red-alert"
            aria-label="Excluir pet"
        >
            <span
                class="text-[22px] leading-[27px] font-medium text-gray-800 whitespace-nowrap"
            >
                Excluir
            </span>
            <img
                src="/images/icons/options/delete.svg"
                alt="Ícone Excluir"
                class="w-6 h-6 flex-shrink-0"
            />
        </button>
    </aside>

    <!-- pop up address -->
    <aside
        data-popup="options-address"
        class="hidden fixed z-[999] flex-col bg-gray-50 rounded-[10px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.25)] min-w-max overflow-hidden animate-fadeTop"
    >
        <button data-button="editAddress"
            class="flex flex-row items-center justify-center gap-[30px] px-9 py-6 w-full bg-gray-100 hover:brightness-95 transition-all duration-200 outline-none focus:ring-2 focus:ring-green-400"
            aria-label="Editar endereco"
        >
            <span 
                class="text-[22px] leading-[27px] font-medium text-green-400 whitespace-nowrap"
            >
                Editar
            </span>
            <img
                src="/images/icons/options/edit.svg"
                alt="Ícone Editar"
                class="w-6 h-6 flex-shrink-0"
            />
        </button>
        <button data-button="deleteAddress"
            class="flex flex-row items-center justify-center gap-[30px] px-9 py-6 w-full bg-gray-100 hover:brightness-95 transition-all duration-200 outline-none focus:ring-2 focus:ring-red-alert"
            aria-label="Excluir pet"
        >
            <span
                class="text-[22px] leading-[27px] font-medium text-gray-800 whitespace-nowrap"
            >
                Excluir
            </span>
            <img
                src="/images/icons/options/delete.svg"
                alt="Ícone Excluir"
                class="w-6 h-6 flex-shrink-0"
            />
        </button>
    </aside>

    <!-- modal alterar email -->
    <aside data-modal="editEmail" class="hidden fixed inset-0 z-20 items-center justify-center bg-black/50 animate-fadeItem">
        <div class="relative w-[95%] max-w-[500px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="editEmail" class="relative bg-white p-6 md:p-10 flex flex-col gap-6">

                <button type="button" data-button="closeEditEmail" class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar">
                </button>

                <h3 class="font-sans font-bold text-xl md:text-2xl text-green-600 pr-10">Alterar Email</h3>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-edit-email" class="font-sans font-semibold text-base md:text-lg text-gray-700">Novo Email</label>
                    <input data-input="editEmail" id="input-edit-email" type="email" name="email" placeholder="seu@email.com" required
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400">
                </div>

                <button data-button="saveEmail" type="button"
                    class="w-full flex items-center justify-center px-6 py-4 bg-green-600 rounded-[10px] hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all">
                    <span class="font-sans font-semibold text-lg md:text-xl text-white uppercase">Salvar</span>
                </button>
            </form>
        </div>
    </aside>

    <aside data-modal="editTelefone" class="hidden fixed inset-0 z-20 items-center justify-center bg-black/50 animate-fadeItem">
        <div class="relative w-[95%] max-w-[500px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="editTelefone" class="relative bg-white p-6 md:p-10 flex flex-col gap-6">

                <button type="button" data-button="closeEditTelefone" class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar">
                </button>

                <h3 class="font-sans font-bold text-xl md:text-2xl text-green-600 pr-10">Alterar Telefone</h3>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-edit-Telefone" class="font-sans font-semibold text-base md:text-lg text-gray-700">Novo Telefone</label>
                    <input data-input="editTelefone" data-input="formatPhone" id="input-edit-Telefone" type="tel" name="Telefone" placeholder="(XX) XX XXXX-XXXX" required
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400">
                </div>

                <button data-button="saveTelefone" type="button"
                    class="w-full flex items-center justify-center px-6 py-4 bg-green-600 rounded-[10px] hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all">
                    <span class="font-sans font-semibold text-lg md:text-xl text-white uppercase">Salvar</span>
                </button>
            </form>
        </div>
    </aside>

    <aside data-modal="editSenha" class="hidden fixed inset-0 z-20 items-center justify-center bg-black/50 animate-fadeItem">
        <div class="relative w-[95%] max-w-[500px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="editSenha" class="relative bg-white p-6 md:p-10 flex flex-col gap-6">

                <button type="button" data-button="closeEditSenha" class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar">
                </button>

                <h3 class="font-sans font-bold text-xl md:text-2xl text-green-600 pr-10">Alterar Senha</h3>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-edit-Senha" class="font-sans font-semibold text-base md:text-lg text-gray-700">Nova Senha</label>
                    <input data-input="editSenha" id="input-edit-Senha" type="password" name="Senha" placeholder="Digite sua senha" required
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400">
                </div>

                <button data-button="saveSenha" type="button"
                    class="w-full flex items-center justify-center px-6 py-4 bg-green-600 rounded-[10px] hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all">
                    <span class="font-sans font-semibold text-lg md:text-xl text-white uppercase">Salvar</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- modal trocar nome -->
    <aside data-modal="editName" class="hidden fixed inset-0 z-20 items-center justify-center bg-black/50 animate-fadeItem">
        <div class="relative w-[95%] max-w-[500px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="editName" class="relative bg-white p-6 md:p-10 flex flex-col gap-6">

                <button type="button" data-button="closeEditName" class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar">
                </button>

                <h3 class="font-sans font-bold text-xl md:text-2xl text-green-600 pr-10">Alterar Nome</h3>

                <div class="flex flex-col gap-[10px]">
                    <label for="input-edit-nome" class="font-sans font-semibold text-base md:text-lg text-gray-700">Digite o seu nome:</label>
                    <input data-input="editName" id="input-edit-Nome" type="text" name="Nome" placeholder="Seu nome completo" required
                        class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400">
                </div>

                <button data-button="saveNome" type="button"
                    class="w-full flex items-center justify-center px-6 py-4 bg-green-600 rounded-[10px] hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all">
                    <span class="font-sans font-semibold text-lg md:text-xl text-white uppercase">Salvar</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- modal adicionar endereço -->
    <aside data-modal="addAddress" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 animate-fadeItem">
        <div class="relative w-[95%] max-w-[720px] rounded-[15px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.15)]">
            <form data-form="addAddress" class="relative max-h-[90vh] overflow-y-auto scroll bg-white p-6 md:p-10 flex flex-col gap-6 md:gap-8">

