                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-6">
                    <div class="flex flex-col gap-[10px]">
                        <span class="font-sans font-semibold text-base md:text-lg text-gray-700">Gênero</span>
                        <div class="flex flex-row gap-6">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input data-input="petGender" type="radio" name="gender" value="Macho" checked required
