            <form data-form="addPet" class="relative max-h-[90vh] overflow-y-auto scroll bg-white p-6 md:p-10 flex flex-col gap-6 md:gap-8">

                <button type="button" data-button="closeFormPet" class="absolute top-4 right-4 md:top-6 md:right-6 w-9 h-9 flex items-center justify-center rounded-full bg-gray-100 hover:bg-red-100 text-gray-500 hover:text-red-500 transition-colors text-xl font-bold leading-none">
                    <img src="/images/icons/administrador/delete-slide.svg" alt="Fechar Formulário" />
                </button>

                <h3 class="font-sans font-bold text-xl md:text-2xl text-green-600 pr-10">Adicionar meu Pet</h3>

                <div class="flex flex-col sm:flex-row gap-6">
