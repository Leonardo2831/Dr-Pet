                    </div>
                    <div class="flex flex-col gap-[10px] sm:w-[150px]">
                        <label for="input-numero" class="font-sans font-semibold text-base md:text-lg text-gray-700">Número</label>
                        <input data-input="numero" id="input-numero" type="text" name="numero" placeholder="Ex: 123" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-6">
                    <div class="flex flex-col gap-[10px] sm:w-[200px]">
                        <label for="input-cep" class="font-sans font-semibold text-base md:text-lg text-gray-700">CEP</label>
                        <input data-input="cep" id="input-cep" type="text" name="cep" placeholder="Ex: 00000-000" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                    <div class="flex flex-col gap-[10px] flex-1">
                        <label for="input-cidade" class="font-sans font-semibold text-base md:text-lg text-gray-700">Cidade</label>
                        <input data-input="cidade" id="input-cidade" type="text" name="cidade" placeholder="Ex: São Paulo" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                    <div class="flex flex-col gap-[10px] sm:w-[100px]">
                        <label for="input-estado" class="font-sans font-semibold text-base md:text-lg text-gray-700">Estado</label>
                        <input data-input="estado" id="input-estado" type="text" name="estado" placeholder="Ex: SP" maxlength="2" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-6">
                    <div class="flex flex-col gap-[10px] flex-1">
                        <label for="input-bairro" class="font-sans font-semibold text-base md:text-lg text-gray-700">Bairro</label>
                        <input data-input="bairro" id="input-bairro" type="text" name="bairro" placeholder="Ex: Centro" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                    <div class="flex flex-col gap-[10px] flex-1">
                        <label for="input-telefone-address" class="font-sans font-semibold text-base md:text-lg text-gray-700">Telefone</label>
                        <input data-input="telefoneAddress" id="input-telefone-address" type="tel" name="telefone" placeholder="(00) 00000-0000" required
                            class="px-4 py-3 w-full border-2 border-gray-300 rounded-[8px] font-medium text-base md:text-lg text-gray-600 outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/20 transition-all placeholder:text-gray-400" />
                    </div>
                </div>

                <button data-button="saveAddress" type="button"
                    class="mt-2 w-full flex items-center justify-center gap-3 px-6 py-4 bg-green-600 rounded-[10px] shadow-sm hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-white focus:ring-offset-2 focus:ring-offset-green-500 transition-all">
                    <span class="font-sans font-semibold text-lg md:text-xl text-white uppercase">Salvar Endereço</span>
                </button>
            </form>
