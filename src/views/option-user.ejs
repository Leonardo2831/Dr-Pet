                                <span class="font-medium text-base md:text-lg text-gray-600">Macho</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input data-input="petGender" type="radio" name="gender" value="Fêmea"
                                    class="w-4 h-4 accent-green-600" />
                                <span class="font-medium text-base md:text-lg text-gray-600">Fêmea</span>
