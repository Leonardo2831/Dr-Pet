<%- include('layouts/header', { tituloDaPagina: 'Dr.Pet | Agendamento' }) %>

<%
    const end = (locals.dataUser && dataUser.endereco) || {};
    const enderecoFormatado = end && end.rua
        ? [end.rua, end.numero ? `nº ${end.numero}` : '', end.bairro, end.cidade, end.estado].filter(Boolean).join(', ') + (end.complemento ? ` (${end.complemento})` : '')
        : '';
%>

    <main class="flex flex-col lg:flex-row">
        <section
            class="order-1 lg:order-2 flex-1 flex items-center justify-center bg-gray-50 px-5 py-10 xs:px-6 xs:py-11 sm:px-8 sm:py-12 lg:px-[60px] lg:py-[60px]"
        >
            <form
                action="#"
                class="w-full flex flex-col gap-10 md:gap-[50px]"
            >
                <h1
                    class="text-green-500 font-bold text-3xl md:text-[40px] md:leading-[50px]"
                >
                    Dados para o Agendamento
                </h1>

                <div class="flex flex-col gap-10 md:gap-[50px]">
                    <fieldset class="flex flex-col gap-6 md:gap-[30px]">
                        <legend class="sr-only">Dados do Dono</legend>

                        <div class="flex flex-col gap-[15px]">
                            <label
                                for="nome"
                                class="text-gray-900 font-medium text-xl md:text-[26px] md:leading-[32px]"
                                >Nome</label
                            >
                            <input
                                type="text"
                                id="nome"
                                name="nome"
                                placeholder="Seu nome completo"
                                class="w-full px-[15px] py-3 md:py-5 border-b-[2px] border-green-700 bg-transparent text-lg md:text-[22px] text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-green-500 transition-colors"
                                required
                                minlength="3"
                                maxlength="50"
                                pattern="^[a-zA-ZÀ-Ã¿\s]+$"
                                value="<%= (locals.dataUser && dataUser.usuario && (dataUser.usuario.nome || dataUser.usuario.name)) || '' %>"
                            />
                        </div>

                        <div class="flex flex-col gap-[15px]">
                            <label
                                for="telefone"
                                class="text-gray-900 font-medium text-xl md:text-[26px] md:leading-[32px]"
                                >Telefone</label
                            >
                            <input
                                data-input="formatPhone"
                                type="tel"
                                id="telefone"
                                name="telefone"
                                placeholder="(00) 00000-0000"
                                class="w-full px-[15px] py-3 md:py-5 border-b-[2px] border-green-700 bg-transparent text-lg md:text-[22px] text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-green-500 transition-colors"
                                required
                                minlength="10"
                                maxlength="15"
                                pattern="^\(?\d{2}\)?\s?\d{4,5}-?\d{4}$"
                                title="Digite um telefone válido com DDD. Ex: (11) 99999-9999 ou 11999999999"
                                value="<%= (locals.dataUser && dataUser.usuario && dataUser.usuario.telefone) || '' %>"
                            />
                        </div>

                        <div class="flex flex-col gap-[15px]">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                                <label
                                    for="endereco"
                                    class="text-gray-900 font-medium text-xl md:text-[26px] md:leading-[32px]"
                                    >Endereço</label
                                >
                                <% if (locals.dataUser && dataUser.length > 0 && dataUser[0].endereco && dataUser[0].endereco.id) { %>
                                    <span class="text-xs md:text-sm text-gray-500 font-normal">
                                        Escolha um endereço salvo ou digite outro
                                    </span>
                                <% } %>
                            </div>

                            <% if (locals.dataUser && dataUser.length > 0 && dataUser[0].endereco && dataUser[0].endereco.id) { %>
                                <div class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-gray-700">Selecione um endereço salvo:</span>
                                    <div class="flex flex-wrap gap-2.5" id="container-botoes-endereco">
                                        <% 
                                        const enderecosRenderizados = [];
                                        dataUser.forEach((item, idx) => { 
                                            const endItem = item.endereco;
                                            if (!endItem || !endItem.id || enderecosRenderizados.includes(endItem.id)) return;
                                            enderecosRenderizados.push(endItem.id);

                                            const partes = [
                                                endItem.rua,
                                                endItem.numero ? `nº ${endItem.numero}` : '',
                                                endItem.bairro,
                                                endItem.cidade,
                                                endItem.estado
                                            ].filter(Boolean).join(', ') + (endItem.complemento ? ` (${endItem.complemento})` : '');
                                            const isPrimeiro = enderecosRenderizados.length === 1;
                                        %>
                                            <button
                                                type="button"
                                                class="btn-escolha-endereco flex items-center gap-2 px-3.5 py-2 rounded-lg border text-sm md:text-base font-medium transition-all duration-200 cursor-pointer <%= isPrimeiro ? 'bg-green-600 text-white border-green-600 shadow-sm' : 'bg-white text-gray-700 border-gray-300 hover:border-green-500 hover:bg-green-50/50' %>"
                                                data-endereco-completo="<%= partes %>"
                                                data-index="<%= enderecosRenderizados.length - 1 %>"
                                                title="<%= partes %>"
                                            >
                                                <span>🏠</span>
                                                <span class="font-semibold">Endereço <%= enderecosRenderizados.length %></span>
                                                <% if (endItem.bairro) { %>
                                                    <span class="text-xs opacity-80">(<%= endItem.bairro %>)</span>
                                                <% } %>
                                            </button>
                                        <% }) %>

                                        <button
                                            type="button"
                                            id="btn-outro-endereco"
                                            class="btn-escolha-endereco flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-dashed border-gray-400 bg-white text-gray-600 hover:border-green-600 hover:text-green-700 hover:bg-green-50 text-sm md:text-base font-medium transition-all duration-200 cursor-pointer"
                                        >
                                            <span> + Outro endereço</span>
                                        </button>
                                    </div>
                                </div>
                            <% } %>

                            <input
                                type="text"
                                id="endereco"
                                name="endereco"
                                placeholder="Ex: Rua do nada, bairro do nada, 100, na frente da pracinha"
                                class="w-full px-[15px] py-3 md:py-5 border-b-[2px] border-green-700 bg-transparent text-lg md:text-[22px] text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-green-500 transition-colors"
                                required
                                minlength="3"
                                maxlength="255"
                                value="<%= enderecoFormatado || (locals.dataUser && dataUser.endereco && dataUser.endereco.rua) || '' %>"
                            />
                        </div>
                    </fieldset>

                    <fieldset class="flex flex-col gap-8 md:gap-[50px]">
                        <legend
                            class="text-green-500 font-semibold text-2xl md:text-[32px] md:leading-[40px] mb-6 w-full"
                        >
                            Dados do pet
                        </legend>

                        <div class="flex flex-col gap-8 md:gap-[30px]">
                            <div class="flex flex-col gap-[15px]">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                                    <label
                                        for="nomePet"
                                        class="text-gray-900 font-medium text-xl md:text-[26px] md:leading-[32px]"
                                    >Nome do pet</label
                                    >
                                    <% if (locals.dataUser && dataUser.length > 0 && dataUser[0].pet && dataUser[0].pet.id) { %>
                                        <span class="text-xs md:text-sm text-gray-500 font-normal">
                                            Escolha um pet cadastrado ou digite outro
                                        </span>
                                    <% } %>
                                </div>

                                <% if (locals.dataUser && dataUser.length > 0 && dataUser[0].pet && dataUser[0].pet.id) { %>
                                    <div class="flex flex-col gap-2">
                                        <span class="text-sm font-semibold text-gray-700">Selecione um dos seus pets:</span>
                                        <div class="flex flex-wrap gap-2.5" id="container-botoes-pet">
                                            <% 
                                            const petsRenderizados = [];
                                            dataUser.forEach((item, idx) => { 
                                                const petItem = item.pet;
                                                if (!petItem || !petItem.id || petsRenderizados.includes(petItem.id)) return;
                                                petsRenderizados.push(petItem.id);

                                                const isPrimeiro = petsRenderizados.length === 1;
                                                const icone = petItem.genero === 'femea' ? '🎀' : '🐾';
                                            %>
                                                <button
                                                    type="button"
                                                    class="btn-escolha-pet flex items-center gap-2 px-3.5 py-2 rounded-lg border text-sm md:text-base font-medium transition-all duration-200 cursor-pointer <%= isPrimeiro ? 'bg-green-600 text-white border-green-600 shadow-sm' : 'bg-white text-gray-700 border-gray-300 hover:border-green-500 hover:bg-green-50/50' %>"
                                                    data-pet-id="<%= petItem.id %>"
                                                    data-pet-nome="<%= petItem.nome || petItem.name %>"
                                                    data-pet-raca="<%= petItem.raca || '' %>"
                                                    data-pet-genero="<%= petItem.genero || '' %>"
                                                    data-index="<%= petsRenderizados.length - 1 %>"
                                                >
                                                    <span><%= icone %></span>
                                                    <span class="font-semibold">Pet <%= petsRenderizados.length %>: <%= petItem.nome || petItem.name %></span>
                                                    <% if (petItem.raca) { %>
                                                        <span class="text-xs opacity-80">(<%= petItem.raca %>)</span>
                                                    <% } %>
                                                </button>
                                            <% }) %>

                                            <button
                                                type="button"
                                                id="btn-outro-pet"
                                                class="btn-escolha-pet flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-dashed border-gray-400 bg-white text-gray-600 hover:border-green-600 hover:text-green-700 hover:bg-green-50 text-sm md:text-base font-medium transition-all duration-200 cursor-pointer"
                                            >
                                                <span> + Outro pet</span>
                                            </button>
                                        </div>
                                    </div>
                                <% } %>

                                <input
                                    type="hidden"
                                    id="petId"
                                    name="petId"
                                    value="<%= (locals.dataUser && dataUser.pet && dataUser.pet.id) || '' %>"
                                />

                                <input
                                    type="text"
                                    id="nomePet"
                                    name="nomePet"
                                    placeholder="Nome do seu pet"
                                    class="w-full px-[15px] py-3 md:py-5 border-b-[2px] border-green-700 bg-transparent text-lg md:text-[22px] text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-green-500 transition-colors"
                                    required
                                    minlength="2"
                                    maxlength="50"
                                    value="<%= (locals.dataUser && dataUser.pet && (dataUser.pet.nome || dataUser.pet.name)) || '' %>"
                                />
                            </div>

                            <!-- Descrição Serviço -->
                            <div class="flex flex-col gap-[15px]">
                                <label
                                    for="descricao"
                                    class="text-gray-900 font-medium text-xl md:text-[26px] md:leading-[32px]"
                                >Descrição do serviço</label
                                >
                                <textarea
                                    id="descricao"
                                    name="descricao"
                                    placeholder="Descreva alguma especificação sobre o serviço, como qual vacina deseja fazer em seu pet..."
                                    class="w-full px-[15px] py-4 md:py-5 border-[3px] border-green-700 rounded-[10px] bg-transparent text-lg md:text-[22px] text-gray-900 placeholder:text-gray-500 focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 resize-none h-[140px] transition-colors"
                                    maxlength="250"
                                ></textarea>
                            </div>

                            <div
                                class="flex flex-row items-center gap-[10px] mt-2 w-fit"
                            >
                                <input
                                    type="checkbox"
                                    id="buscarResidencia"
                                    name="buscarResidencia"
                                    class="w-6 h-6 border-[2px] border-green-500 rounded-[6px] accent-green-500 cursor-pointer focus:ring-2 focus:ring-green-500 focus:ring-offset-2 bg-transparent"
                                />
                                <label
                                    for="buscarResidencia"
                                    class="text-gray-900 font-medium text-lg md:text-[22px] cursor-pointer select-none hover:text-green-500 transition-colors"
                                >Buscar em residência?</label
                                >
                            </div>
                        </div>
                    </fieldset>
                </div>

                <button
                    type="submit"
                    class="w-full rounded-[10px] bg-green-600 px-8 py-4 flex items-center justify-center hover:bg-green-500 transition-colors outline-none focus:ring-4 focus:ring-green-600 mx-auto"
                >
                    <span
                        class="font-semibold text-[22px] leading-[28px] text-gray-50 xs:text-[24px] xs:leading-[30px] sm:text-[26px] sm:leading-[33px] lg:text-[30px] lg:leading-[37px]"
                        >Finalizar Agendamento</span
                    >
                </button>
            </form>
        </section>

        <figure class="order-2 lg:order-1 flex-1 w-full relative min-h-[300px] lg:min-h-0">
            <img
                src="/images/forms-images/login.jpg"
                alt="Dados do Agendamento"
                class="lg:absolute lg:inset-0 w-full h-full object-cover"
            />
        </figure>
    </main>

    <aside
        data-modal-info-menu="user"
        data-modal-info="formSchedule"
        class="hidden z-[1000] animate-fadeItem opacity-0 fixed bottom-8 left-1/2 -translate-x-1/2 p-4 text-center font-semibold text-lg"
    ></aside>

<%- include('layouts/footer', { scripts: [
    { src: '/javascript/menu-user/script-menu-user.js', module: true },
    { src: '/javascript/forms/agendamento-service/script-agendamento-form.js', module: true }    
] }) %>