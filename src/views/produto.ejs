<%- include('layouts/header', { tituloDaPagina: 'Dr.Pet | Produto', swiper: true }) %>

    <div class="bg-gray-50">
        <main class="main container flex flex-col gap-10 md:gap-14 px-4 md:px-8 lg:px-12 py-8 md:py-12">
            <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 w-full">
                <section class="relative w-full lg:w-1/2 bg-gray-100 rounded-[10px] flex flex-col items-center justify-center py-10 px-6 md:px-[60px] gap-[60px] shadow-sm">
                    <button class="produto-about-swiper-button-prev hidden md:flex absolute left-10 md:left-12 lg:left-14 top-1/2 -translate-y-1/2 z-10 w-10 h-10 lg:w-[60px] lg:h-[60px] bg-white hover:bg-green-600 items-center justify-center rounded-full shadow hover:shadow-lg transition-all duration-300 outline-none focus:ring-4 focus:ring-green-400 group">
                        <img src="/images/icons/slide/arrow-left.svg" alt="Próximo" class="w-6 h-6 lg:w-6 lg:h-6 invert-[0.3] group-hover:brightness-0 group-hover:invert transition-all duration-300"/>
                    </button>
                    <button class="produto-about-swiper-button-next hidden md:flex absolute right-10 md:right-12 lg:right-14 top-1/2 -translate-y-1/2 z-10 w-10 h-10 lg:w-[60px] lg:h-[60px] bg-white hover:bg-green-600 items-center justify-center rounded-full shadow hover:shadow-lg transition-all duration-300 outline-none focus:ring-4 focus:ring-green-400 group">
                        <img src="/images/icons/slide/arrow-right.svg" alt="Próximo" class="w-6 h-6 lg:w-6 lg:h-6 invert-[0.3] group-hover:brightness-0 group-hover:invert transition-all duration-300"/>
                    </button>

                    <div class="swiper product-about-gallery w-full max-w-[488px]">
                        <div data-content="galeryImagesSlideProduct" class="swiper-wrapper"></div>
                    </div>

                    <div class="swiper product-about-thumbs w-full max-w-[350px] px-2 py-4">
                        <div data-content="thumbsSlideProduct" class="swiper-wrapper p-2"></div>
                    </div>
                </section>

                <section class="w-full lg:w-1/2 flex flex-col bg-white rounded-[10px] p-6 md:p-10 shadow-sm">
                    <div class="flex flex-col justify-between h-full gap-6 md:gap-[30px]">
                        <div class="flex flex-col gap-5">
                            <header class="flex flex-col gap-[10px]">
                                <h1 data-product="title" class="text-gray-700 font-bold text-2xl md:text-[32px] md:leading-10"></h1>
                                <span data-product="price" class="text-green-600 font-semibold text-3xl md:text-[36px] md:leading-[44px]"></span>
                            </header>
                            <div data-product="description" class="text-gray-700 font-normal text-base md:text-[20px] leading-relaxed md:leading-[25px] flex flex-col gap-1 max-h-[700px] overflow-y-auto scroll pb-2"></div>
                        </div>
                        <div class="flex flex-col gap-6 md:gap-[30px] border-t border-green-400 pt-7">
                            <div class="flex flex-col gap-3 md:gap-[15px] text-center">
                                <h2 class="text-green-700 font-semibold text-xl md:text-[26px] md:leading-[32px]">
                                    Gostou do produto?
                                </h2>
                                <p class="text-black font-normal text-sm md:text-[16px] md:leading-[20px]">
                                    Como não realizamos vendas pelo
                                    site, clique no botão abaixo para
                                    falar diretamente com nossa equipe,
                                    tirar dúvidas ou reservar o seu.
                                </p>
                            </div>
                            <button data-button="contact"
                                class="flex items-center justify-center gap-4 md:gap-[24px] bg-green-600 hover:bg-green-700 transition-colors duration-300 py-3 md:py-[12px] px-6 md:px-[36px] rounded-[5px] shadow w-full max-w-[627px] mx-auto focus:outline-none focus:ring-4 focus:ring-green-400 group">
                                <img
                                    src="/images/icons/chat.svg"
                                    alt="Ícone de Chat"
                                    class="w-6 h-6 md:w-[30px] md:h-[30px] transition-transform duration-300 group-hover:scale-110"
                                />
                                <span class="text-gray-50 font-semibold text-lg md:text-[26px] md:leading-[32px] uppercase">
                                    Consultar Conosco
                                </span>
                            </button>
                        </div>
                    </div>
                </section>
            </div>

            <section
                class="bg-gray-100 py-10 px-6 md:px-[60px] lg:px-[120px] md:py-[50px] rounded-[10px] relative w-full shadow-sm"
            >
                <h2
                    class="text-green-600 font-semibold text-[28px] md:text-[32px] lg:text-[40px] text-left w-full mb-8"
                >
                    Outros Produtos
                </h2>

                <div class="swiper product-swiper w-full overflow-hidden pb-4">
                    <div data-content="slide-products" class="swiper-wrapper"></div>
                </div>
                <!-- Navigation Buttons -->
                <button
                    class="group loja-swiper-button-prev hidden md:flex absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 lg:w-14 lg:h-14 bg-white hover:bg-green-600 items-center justify-center rounded-full shadow-md hover:shadow-xl hover:scale-105 transition-all duration-300 outline-none focus:ring-4 focus:ring-green-400"
                >
                    <img
                        src="/images/icons/slide/arrow-left.svg"
                        alt="Anterior"
                        class="w-6 h-6 invert-[0.3] group-hover:brightness-0 group-hover:invert transition-all duration-300"
                    />
                </button>
                <button
                    class="group loja-swiper-button-next hidden md:flex absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 lg:w-14 lg:h-14 bg-white hover:bg-green-600 items-center justify-center rounded-full shadow-md hover:shadow-xl hover:scale-105 transition-all duration-300 outline-none focus:ring-4 focus:ring-green-400"
                >
                    <img
                        src="/images/icons/slide/arrow-right.svg"
                        alt="Próximo"
                        class="w-6 h-6 invert-[0.3] group-hover:brightness-0 group-hover:invert transition-all duration-300"
                    />
                </button>
            </section>
        </main>
    </div>

    <aside
        data-modal-info-menu="user"
        data-modal-info="product"
        class="hidden z-30 animate-fadeItem opacity-0 fixed bottom-8 left-1/2 -translate-x-1/2 p-4 text-center font-semibold text-lg"
    ></aside>

    <!-- Modal de checar login -->
    <aside data-modal="loginRequired" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
            
        <div data-login-overlay class="absolute inset-0 bg-black/60 opacity-0"></div>

        <div data-login-content class="relative w-full max-w-[460px] bg-gray-50 rounded-2xl shadow-2xl overflow-hidden opacity-0">
            <header class="bg-green-600 px-5 py-5 xs:px-8 xs:py-7 flex items-center justify-between">
                <figure class="flex items-center gap-4">
                    <img src="/images/logo.png" alt="Logo Dr. Pet" class="w-[34px] xs:w-[42px] h-auto object-contain" />
                    <span class="text-lg xs:text-xl md:text-2xl font-semibold text-gray-50">Dr. Pet</span>
                </figure>
                <button data-login-close class="text-gray-50 hover:text-green-200 transition-colors duration-200 p-1 outline-none focus:ring-2 focus:ring-green-200 rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </header>

            <div class="px-5 py-5 xs:px-8 xs:py-8 flex flex-col items-center gap-4 xs:gap-6 text-center">
                    
                <figure class="w-[56px] h-[56px] xs:w-[72px] xs:h-[72px] bg-green-500 rounded-full flex items-center justify-center shadow-sm">
                    <img src="/images/icons/user.svg" alt="Criar Conta">
                </figure>

                <div class="flex flex-col gap-2">
                    <h3 class="text-xl xs:text-2xl md:text-[26px] font-bold text-gray-800 leading-tight">
                        Acesse sua conta
                    </h3>
                    <p class="text-sm xs:text-base md:text-lg font-medium text-gray-500 leading-relaxed max-w-[360px]">
                        Para agendar serviços para o seu pet, é necessário estar logado na sua conta.
                    </p>
                </div>

                <a href="/cadastrar"
                    class="min-w-0 w-full flex items-center justify-center gap-2 xs:gap-3 px-3 xs:px-6 py-3 xs:py-4 bg-green-500 hover:bg-green-400 text-xs xs:text-base md:text-xl font-bold text-gray-50 uppercase rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                    <img src="/images/icons/user.svg" alt="Criar Conta" class="w-5 h-5 shrink-0">
                    <span class="truncate">Criar minha conta</span>
                </a>

                <div class="flex items-center gap-4 w-full">
                    <div class="flex-1 h-px bg-gray-200"></div>
                    <span class="text-sm font-medium text-gray-400 uppercase tracking-wide">ou</span>
                    <div class="flex-1 h-px bg-gray-200"></div>
                </div>

                <a href="/login"
                    class="min-w-0 w-full flex items-center justify-center gap-3 px-3 xs:px-6 py-3 xs:py-[14px] border-2 border-green-500 text-green-600 hover:bg-green-50 text-xs xs:text-base md:text-lg font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 outline-none focus:ring-4 focus:ring-green-300 overflow-hidden">
                    <span class="truncate">Já tenho uma conta</span>
                </a>
            </div>
        </div>
    </aside>

<%- include('layouts/footer', { scripts: [
    { src: '/javascript/produto/script-product.js', module: true },
    { src: '/javascript/menu-user/script-menu-user.js', module: true }
] }) %>


