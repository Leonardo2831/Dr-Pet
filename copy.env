# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=SUA_PORTA
DB_USER=root
DB_PASSWORD=SENHA_BANCO_DADOS
DB_NAME=petshop

# Configurações de Envio de E-mail (Gmail SMTP)
HOST_EMAIL=smtp.gmail.com
PORT_EMAIL=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=SENHA_DE_APP_DO_GMAIL

# Ambiente e endereço do servidor
# Em produção, use NODE_ENV=production e a URL pública do site em APP_URL.
NODE_ENV=development
PORT=3000

# Sessão
SESSION_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_LONGA

# Login com Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth, tipo Aplicativo da Web)
# URI de redirecionamento autorizada: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Endereço público do site (usado nos links enviados por e-mail, ex.: recuperação de senha)
APP_URL=http://localhost:3000
